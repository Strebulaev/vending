<body class="relative">
    <section id="gallerySlider" class="hidden fixed inset-0 w-screen h-screen z-[100001] flex flex-col items-center justify-center gap-6">
    <div class="absolute inset-0 bg-black opacity-90"></div>

    <button type="button" id="closeGallery" class="absolute flex top-8 right-8 cursor-pointer hover:scale-110 duration-150 ease-in-out z-[200]">
        <svg width="29" height="29" viewBox="0 0 29 29" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M1 1L28 28" stroke="white" stroke-width="2"/>
            <path d="M1 1L28 28" stroke="white" stroke-width="2"/>
            <path d="M28 1L1 28" stroke="white" stroke-width="2"/>
            <path d="M28 1L1 28" stroke="white" stroke-width="2"/>
        </svg>
    </button>
    <div class="top-10 relative w-full flex justify-center items-center gap-y-4 z-[100]">
        <button type="button" id="leftGalleryBtn" class="absolute hidden sm:flex left-8 cursor-pointer hover:scale-110 duration-150 ease-in-out">
            <svg width="18" height="32" viewBox="0 0 18 32" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M16 2L2 16L16 30" stroke="white" stroke-opacity="0.7" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
        </button>
        <div class="flex flex-col justify-center items-center">
