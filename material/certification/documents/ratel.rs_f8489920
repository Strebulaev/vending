            <p id="displayedImageTitle" class="hidden xs:flex text-center mt-4 text-sm md:text-md text-white font-normal px-2"></p>
        </div>
        <button type="button" id="rightGalleryBtn" class="absolute hidden sm:flex right-8 cursor-pointer hover:scale-110 duration-150 ease-in-out">
            <svg width="18" height="32" viewBox="0 0 18 32" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M2 2L16 16L2 30" stroke="white" stroke-opacity="0.7" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
        </button>
    </div>
    <div id="bottomGallery" class="w-full h-36 relative flex flex-wrap justify-center gap-4 mt-12 overflow-x-auto max-w-[calc(6*image-width)]"></div>
</section>
