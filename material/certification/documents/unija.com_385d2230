            background: rgba(58, 167, 204, 0.1);
					border-top: 1px solid rgba(58, 167, 204, 0.1);
					
			
					
            color: #3aa7cc;
            font-weight: 600;
            text-transform: uppercase;
            font-size: 0.875rem;
            letter-spacing: 0.05em;
        }
        
        .u-accordion-content th:first-child {
            border-top-left-radius: 1em;
        }
        
        .u-accordion-content th:last-child {
            border-top-right-radius: 1em;
        }
        
        .u-accordion-content tr:last-child td {
