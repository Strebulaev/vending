/* By @datio-it
 * --------------------*/
.calc-filter {
	margin: 30px 0;
	display: flex;
	justify-content: flex-start;
	column-gap: 10px;
	align-items: center;
}
.calc-filter a.active {
	background-color: #7a003c;
	font-weight: bold;
	color: #fff;
	padding: 10px;
}
.calc-filter a {
	background-color: rgba(0, 0, 0, 5%);
	padding: 10px;
	transition: all 0.2s ease;
}
.calc-filter a:hover {
	background-color: #7a003c;
	color: #fff;
	font-weight: bold;
}
.calc-field-group input {
	padding: 5px 0 5px 5px;
}
.calc-user-input > div:nth-child(odd), .calc-user-output > div:nth-child(odd) {
    background-color: rgba(0, 0, 0, 0.04);
}
.calc-user-input,
.calc-user-output {
    box-shadow: 0px 0px 12px rgba(0, 0, 0, 0.08);
    border: 3px solid rgba(0, 0, 0, 0.12);
}
.calc-field-group {
    display: flex;
    justify-content: space-between;
    font-size: 16px;
    align-items: center;
    border-top: 1px solid rgba(0, 0, 0, 0.12);
}
.calc-field-group label {
    padding-left: 5px;
}
.calc-user-input {
    margin-bottom: 30px;
}

.calc-user-output {
	margin-bottom: 30px;
}
.calc-user-output .calc-field-group {
    padding: 5px 0 5px 5px;
}
.calc-field-group > * {
	  width: 33.33%;
}

