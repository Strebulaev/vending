    <script>
    document.addEventListener('DOMContentLoaded', function () {
        let cssPaths = [];

        // We are dynamically loading all core and themes styles for all the module
        
                cssPaths.push("https://www.ratel.rs/core/css/app.css");
                cssPaths.push("https://www.ratel.rs/primary-theme/css/theme.css");
        
        lazyLoadCss(cssPaths);

        function lazyLoadCss(paths) {
            let head = document.getElementsByTagName('head')[0];
            paths.forEach((path) => {
                let link = document.createElement('link');
                link.href = path;
                link.rel = 'stylesheet';
                link.type = 'text/css';
                head.appendChild(link);
            });
        }
    });
</script>
