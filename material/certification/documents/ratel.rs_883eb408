        <!-- Scripts -->
        <script>
    function lazyLoadScripts(urls) {
        let bodyTag = document.getElementsByTagName('body')[0];
        urls.forEach((url) => {
            let scriptTag = document.createElement('script');
            scriptTag.type = 'text/javascript';
            scriptTag.async = true;
            scriptTag.src = url;
            bodyTag.appendChild(scriptTag);
        });
    }

    document.addEventListener('DOMContentLoaded', function () {
        // Paths for scripts which are lazy loaded
        let scriptPaths = [];

                scriptPaths.push('https://www.ratel.rs/core/js/app.js');
                scriptPaths.push('https://www.ratel.rs/core/js/google-analytics.js');
                scriptPaths.push('https://www.ratel.rs/primary-theme/js/theme.js');
                scriptPaths.push('https://www.ratel.rs/primary-theme/js/theme.js.LICENSE.txt');
        
        let isGoogleCaptchaSet = true;
        let isGoogleAnalyticsSet = true;
        let userHasConsentedWithCookies = false;
        // Greater than one because there is always one form in the header (language switcher)
        let pageHasForm = document.getElementsByTagName('form').length > 1;
        // If Hotel module is active and there is booking widget on the page
        let pageHasBookingWidget = document.getElementById('booking-calendar-root') && false;

        // Only when hotel module is active and there is widget on the page load scripts for it
        if (pageHasBookingWidget) {
            scriptPaths.push('https://www.ratel.rs/primary-theme/js/booking-widget-main.js');
            scriptPaths.push('https://www.ratel.rs/primary-theme/js/787.29e81ec6.chunk.js');
        }

        // Only load form script if there is actual form on page.
        if (pageHasForm) {
            scriptPaths.push('https://www.ratel.rs/core/js/forms.js');
        }

        // Only load captcha when it is present and there is form.
        if (pageHasForm && isGoogleCaptchaSet) {
            scriptPaths.push('https://www.google.com/recaptcha/api.js?render=GOOGLE_CAPTCHA_CODE');
            scriptPaths.push('https://www.ratel.rs/core/js/grecaptcha.js');
        }

        // Only load analytics when it is present
        if (isGoogleAnalyticsSet && userHasConsentedWithCookies) {
            scriptPaths.push('https://www.googletagmanager.com/gtag/js?id=GOOGLE_ANALYTICS_MEASUREMENT_ID');
            scriptPaths.push('https://www.ratel.rs/core/js/google-analytics.js');
        }


        // Call main functions.
        lazyLoadScripts(scriptPaths);
    }, { passive: true });
</script>
    </div>

<script>
    const header = document.getElementById('header');

    const callback = function (mutationsList, observer) {
    for (const mutation of mutationsList) {
        if (mutation.type === 'attributes' && mutation.attributeName === 'inert') {
        header.removeAttribute('inert');
        }
    }
    };

    const observer = new MutationObserver(callback);

    observer.observe(header, { attributes: true, attributeFilter: ['inert'] });

    document.addEventListener("DOMContentLoaded", function () {
        const menuIcon = document.querySelector(".hamburger-menu-icon");
        menuIcon.addEventListener("click", function () {
            this.classList.toggle("open");
        });
    });
</script>
<!-- Cookie --------------------------------------------------------------------->
<section
    class="cookie-consent-js fixed bottom-0 right-0 flex flex-col w-full box-shadow p-8 mx-auto bg-white md:mx-0 lg:w-2/5 md:w-3/5 md:bottom-10 md:right-10 md:left-auto z-[500]"
>
    <p class="font-bold text-base md:text-lg mt-4">
        Sajt www.ratel.rs koristi samo nužne kolačiće. <a class="hover:underline text-primary" href="https://www.ratel.rs/sr/politika-privatnosti?">Više o kolačićima pročitajte ovde.</a>    </p>

    <!-- Btn -->
    <div class="flex gap-4 mt-10 text-center uppercase w-full">
        <button
            class="js-cookie-consent-agree hover:underline text-primary md:text-xl uppercase w-full py-3"
        >
            Prihvati kolačiće        </button>
        <a class="w-full" href="https://ratel.rs/cyr/politika-privatnosti">
            <button
                class="js-cookie-consent-disagree hover:underline text-primary md:text-xl uppercase w-full py-3"
            >
                Saznaj više            </button>
        </a>
    </div>
</section>

    <script>
        window.laravelCookieConsent = (function () {
            const COOKIE_ACCEPT_VALUE = 1;
            const COOKIE_DECLINE_VALUE = 0;
            const COOKIE_DOMAIN = 'ratel.rs';

            function consentWithCookies() {
                setCookie('ratel_cookie_consent', COOKIE_ACCEPT_VALUE, 7300);
                hideCookieDialog();
            }

            function declineCookieConsent() {
                setCookie('ratel_cookie_consent', COOKIE_DECLINE_VALUE, 7300);
                hideCookieDialog();
            }

            function cookieExists(name) {
                return (document.cookie.split('; ').indexOf(name + '=' + COOKIE_ACCEPT_VALUE) !== -1) ||
                    (document.cookie.split('; ').indexOf(name + '=' + COOKIE_DECLINE_VALUE) !== -1)
            }

            function hideCookieDialog() {
                const dialogs = document.getElementsByClassName('cookie-consent-js');

                for (let i = 0; i < dialogs.length; ++i) {
                    dialogs[i].style.setProperty('display', 'none', 'important');
                }
            }

            function setCookie(name, value, expirationInDays) {
                const date = new Date();
                date.setTime(date.getTime() + (expirationInDays * 24 * 60 * 60 * 1000));
                document.cookie = name + '=' + value
                    + ';expires=' + date.toUTCString()
                    + ';domain=' + COOKIE_DOMAIN
                    + ';path=/;secure'
                    + ';samesite=lax';
            }

            function addClickEventToButtons(buttons, callback) {
                for (let i = 0; i < buttons.length; ++i) {
                    buttons[i].addEventListener('click', callback);
                }
            }

            if (cookieExists('ratel_cookie_consent')) {
                hideCookieDialog();
            }

            addClickEventToButtons(document.getElementsByClassName('js-cookie-consent-agree'), () => {
                consentWithCookies();
                location.reload();
            });
            addClickEventToButtons(document.getElementsByClassName('js-cookie-consent-disagree'), declineCookieConsent);

            return {
                consentWithCookies: consentWithCookies,
                hideCookieDialog: hideCookieDialog
            };
        })();
    </script>
</body>
