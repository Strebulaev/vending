<script>
    dropdownButton = document.getElementById('dropdownButton');
    dropdownContent = document.getElementById('dropdownContent');
    searchBarSection = document.getElementById('searchBarSection');
    searchBarButton = document.getElementById('searchBarButton');
    searchBarSvg = document.getElementById('searchBarSvg');
    searchBarPath = document.getElementById('searchBarPath');
    dimScreen = document.getElementById('dimScreen');

    searchBarButton.addEventListener('click', () => {
        searchBarSection.classList.toggle('hidden');
        searchBarSvg.classList.toggle('scale-110');
        searchBarPath.classList.toggle('fill-primary');
        dimScreen.classList.toggle('hidden');
        document.body.classList.toggle('overflow-hidden')
    })

    dimScreen.addEventListener('click', () => {
        searchBarSection.classList.toggle('hidden');
        searchBarSvg.classList.toggle('scale-110');
        searchBarPath.classList.toggle('fill-primary');
        dimScreen.classList.toggle('hidden');
        document.body.classList.toggle('overflow-hidden')
    })

    dropdownButton.addEventListener('mouseenter', () => {
        dropdownContent.classList.remove('hidden');
    });

    dropdownButton.addEventListener('mouseleave', () => {
        setTimeout(() => {
            if (!dropdownContent.matches(':hover')) {
                dropdownContent.classList.add('hidden');
            }
        }, 200);
    });

    dropdownContent.addEventListener('mouseleave', () => {
        dropdownContent.classList.add('hidden');
    });


</script>
