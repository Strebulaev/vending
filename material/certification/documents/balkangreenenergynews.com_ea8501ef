    var siteKey = '6LcNAvAsAAAAACrOG7ICQizFbtW4Dh5vW4norjbd';
    var scriptLoading = false;
    var scriptLoaded = false;
    var queue = [];

    function flushQueue() {
        while (queue.length) {
            var cb = queue.shift();
            if (typeof cb === 'function') cb();
        }
    }

    function loadRecaptcha(callback) {
        if (callback) {
            queue.push(callback);
        }

        if (scriptLoaded && typeof grecaptcha !== 'undefined') {
            grecaptcha.ready(flushQueue);
            return;
        }

        if (scriptLoading) {
            return;
        }

        scriptLoading = true;

        var script = document.createElement('script');
        script.src = 'https://www.google.com/recaptcha/api.js?render=' + encodeURIComponent(siteKey);
        script.async = true;
        script.defer = true;

        script.onload = function () {
            scriptLoading = false;
            scriptLoaded = true;

            if (typeof grecaptcha !== 'undefined') {
                grecaptcha.ready(flushQueue);
            }
        };

        script.onerror = function () {
            scriptLoading = false;
            queue = [];
            console.error('reCAPTCHA failed to load');
        };

        document.body.appendChild(script);
    }

    function setToken(form, token) {
        var input = form.querySelector('input[name="g-recaptcha-response"]');

        if (!input) {
            input = document.createElement('input');
            input.type = 'hidden';
            input.name = 'g-recaptcha-response';
            form.appendChild(input);
        }

        input.value = token;
    }

    function executeForForm(form, action, callback) {
        loadRecaptcha(function () {
            grecaptcha.execute(siteKey, { action: action || 'submit' }).then(function (token) {
                setToken(form, token);

                if (typeof callback === 'function') {
                    callback(token);
                }
            });
        });
    }

    window.CubesRecaptcha = {
        load: loadRecaptcha,
        executeForForm: executeForForm
    };

    document.addEventListener('DOMContentLoaded', function () {
       document.querySelectorAll('.contact-form, #commentform, .advertise-form')
.forEach(function (form) {
            form.addEventListener('focusin', function () {
                loadRecaptcha();
            }, { passive: true });

            form.addEventListener('mouseenter', function () {
                loadRecaptcha();
            }, { passive: true, once: true });
        });
    });

   function bindClassicFormSubmit(selector, actionName) {
    document.addEventListener('submit', function (e) {
        var form = e.target;

        if (!form.matches(selector)) return;

        if (form.dataset.recaptchaVerified === '1') {
            form.dataset.recaptchaVerified = '0';
            return true;
        }

        if (window.jQuery) {
            var $form = window.jQuery(form);

            if ($form.data('validator')) {
                if (!$form.valid()) {
                    return;
                }
            }
        }

        if (typeof form.checkValidity === 'function' && !form.checkValidity()) {
            return;
        }

        e.preventDefault();

        executeForForm(form, actionName, function () {
            form.dataset.recaptchaVerified = '1';

            if (typeof form.requestSubmit === 'function') {
                form.requestSubmit();
            } else {
                var submitEvent = new Event('submit', { bubbles: true, cancelable: true });
                form.dispatchEvent(submitEvent);
            }
        });
    }, true);
}

    bindClassicFormSubmit('form.contact-form', 'contact');
   bindClassicFormSubmit('form.advertise-form', 'advertise');
    bindClassicFormSubmit('form#commentform', 'comment');
})();</script><script>jQuery.event.special.touchstart = {
