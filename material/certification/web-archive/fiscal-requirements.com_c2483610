<script>
    $('.validation-container').delay(5500).fadeOut(350);

    var popUpTimeout;

    function showMessage(type, msg) {
        $('.js-message').text(msg);
        if (type === 'success') {
            $('.js-validation-message').css({
                'background': '#02C874'
            });
        } else {
            $('.js-validation-message').css({
                'background': '#FF505B'
            });
        }

        $('.js-message-container').css({
            'right': '50px'
        });
        if (popUpTimeout) clearTimeout(popUpTimeout);

        popUpTimeout = setTimeout(() => {
            $('.js-message-container').css({
                'right': '-1000px'
            });
        }, 5500);
    }

</script>

