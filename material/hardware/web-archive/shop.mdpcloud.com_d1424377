require(['jquery', 'tabs'], function($) {
    var $productTabs = $('#product-tabs-6aca18671fa00');
    $.mage.tabs({"openedState":"active"}, $productTabs);
    var mageTabs = $productTabs.data('mageTabs');
    if (mageTabs) {
        if (!$productTabs.data('ui-tabs')) {
            $productTabs.data('ui-tabs', mageTabs);
        }
        $('.data.item.title', $productTabs).each(function(i, el) {
            el.scrollIntoView = function() {};
        });
        var deskTabs = function() {
            mageTabs.options.collapsible = false;
            mageTabs._callCollapsible();
            if ($productTabs.find('[aria-selected="true"]').length == 0) {
                mageTabs.activate(0);
            }
        };
        var mobiTabs = function() {
            mageTabs.options.collapsible = true;
            mageTabs._callCollapsible();
        };
        var deskFirst = false; //fix page scroll down issue in Firefox and IE;
        if (window.innerWidth < 768) {
            mobiTabs();
        } else {
            deskFirst = true;
        }
        $(window).on('cdz_desktop', function() {
            if (deskFirst) {
                deskFirst = false;
            } else {
                deskTabs();
            }
        }).on('cdz_mobile', mobiTabs);
    }
    var collapseText = function ($wrap, maxHeight, viewMoreText, viewLessText) {
        var $panel = $('<div>').addClass('panel-toggle-wrap'),
        $outer = $('<div>').addClass('content-outer'), $inner = $('<div>').addClass('content-inner'),
        $toolbar = $('<div>').addClass('content-toolbar'),
        $toggle = $('<div>').addClass('content-toggle').html(viewMoreText);
        $wrap.children().appendTo($inner);
        $inner.appendTo($outer);       
        $outer.appendTo($panel).css({maxHeight: maxHeight, overflow: 'hidden'});
        $toolbar.appendTo($panel);
        $toggle.appendTo($toolbar);
        $panel.appendTo($wrap);
        $toggle.on('click', function(e){
            e.preventDefault();
            $panel.toggleClass('content-open').hasClass('content-open') ? $toggle.html(viewLessText) : $toggle.html(viewMoreText);
        });
        function apply() {
            ($wrap.innerHeight() > maxHeight)? $panel.addClass('applied'):$panel.removeClass('applied');
        }
        apply();
        $(window).on('resize', apply);
    }
    var $desc = $('#description');
    if ($desc.length) {
        collapseText($desc, 300, '<span>More view</span>', '<span>Less view</span>');
    }});
</script><div class="product-tabs-main">
<div class="product-tabs-info">
<div class="tab-title-main">Warranty and information</div>
<div class="product-tabs-inner">
<div class="tab-title">
<div id="payment" class="title active" content-id="mokejimo_politika">Payment and delivery</div>
<div id="waranty" class="title" content-id="garantija">Warranties</div>
<div id="return" class="title" content-id="grazinimas">Returns</div>
</div>
<div class="tab-content">
<div id="mokejimo_politika" class="product attribute active">
<div class="value">
<p>Order goods online and pay with the electronic banking systems of the following banks: SEB, Swedbank, Luminor (DNB, Nordea), Šiaulių bankas, Danske Bank, Citadelė, Medicinos bankas, Paysera.</p>
<p>After placing orders before 11:00, the delivery time of the goods is 1 - 3 working days, other (longer) delivery terms apply to certain groups of goods. Due to the delivery service, the delivery time may be extended by 1 working day. Delivery to major Lithuanian cities (Vilnius, Kaunas, Klaipėda, Šiauliai, Panevėžys, Alytus, Marijampolė, Tauragė, Telšiai, Utena) is also possible on Saturdays.</p>
Important! Door-to-door service is not included. For goods over 30 kg or if you choose the delivery / handling service, the delivery of goods in the largest cities of Lithuania is carried out from 8:00 to 16:00. period.</div>
</div>
<div id="garantija" class="product attribute">
<div class="value">Goods purchased in the MDP CLOUD online store shop.mdpcloud.lt are subject to warranty terms and conditions set by the manufacturers. The goods are subject to the 24-month period set by the Republic of Lithuania. warranty period, manufacturers may set different (shorter or longer) warranty periods for certain product groups, in which case the manufacturer's warranty period applies.</div>
</div>
<div id="grazinimas" class="product attribute">
<div class="value">
<p>After purchasing the goods online, you have the right to cancel the purchase and sale agreement within 14 working days from the date of delivery of the goods by notifying the e-mail. by e-mail: shop@mdpcloud.lt or in writing by sending a registered letter to: Kareivių st. 11B, LT-09109, Vilnius.</p>
<p>In case you find that the product is of poor quality, you can return the purchase to us within 14 working days from the date of delivery. A defective product will be replaced free of charge or the money paid for the product will be refunded. In case of a refund, the logistics-related costs are deducted from the amount paid - delivery and delivery costs are borne by the customer.</p>
</div>
</div>
</div>
</div>
</div>
