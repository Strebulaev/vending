/thumbnail?ts=2026-10-08T22:55:28","https://static.kurir.rs/api/v3/images/2675576/medium?ts=2026-10-08T22:55:28","Screenshot 2026-10-08 225415.png",[538,540,542,544,546],{"Name":36,"Url":539,"Width":38,"Height":39},"https://static.kurir.rs/api/v3/images/108/216/2675576?ts=2026-10-08T22:55:28",{"Name":41,"Url":541,"Width":43,"Height":44},"https://static.kurir.rs/api/v3/images/226/452/2675576?ts=2026-10-08T22:55:28",{"Name":46,"Url":543,"Width":48,"Height":49},"https://static.kurir.rs/api/v3/images/468/936/2675576?ts=2026-10-08T22:55:28",{"Name":51,"Url":545,"Width":53,"Height":54},"https://static.kurir.rs/api/v3/images/688/1376/2675576?ts=2026-10-08T22:55:28",{"Name":56,"Url":547,"Width":58,"Height":59},"https://static.kurir.rs/api/v3/images/1024/2048/2675576?ts=2026-10-08T22:55:28",{"DocumentId":549,"Title":550,"ShortDescription":11,"ParentMenuItemName":63,"RootMenuItemName":64,"WebUrl":551,"DocumentTypeAlias":66,"MasterDocumentId":552,"ParentMenuItemId":68,"RootMenuItemId":69,"CommentsNumber":553,"LastEditDate":554,"PublishedDate":554,"PosterPhoto":555},10127281,"\"JESTE LI ČULI ŠTA SU REKLI TRAMP, PUTIN, SI ĐINPING... PA JESTE LI OZBILJNI\" Vučić odgovorio na pitanje o Marti Kos: Da to uradim, bio bih kandidat za Nobela","https://www.kurir.rs/vesti/politika/10127281/aleksandar-vucic-marta-kos",1620105,21,"2026-10-08T08:36:45",{"ImageId":556,"Description":11,"CopyRight":29,"ImageUrl":557,"ThumbnailUrl":558,"MediumImageUrl":559,"AltText":560,"Variations":561},2674779,"https://static.kurir.rs/api/v3/images/2674779?ts=2026-10-08T08:37:43","https://static.kurir.rs/api/v3/images/2674779/thumbnail?ts=2026-10-08T08:37:43","https://static.kurir.rs/api/v3/images/2674779/medium?ts=2026-10-08T08:37:43","Aleksandar Vučić Vladimir Putin Si Đinping Donald Tramp",[562,564,566,568,570],{"Name":36,"Url":563,"Width":38,"Height":80},"https://static.kurir.rs/api/v3/images/108/216/2674779?ts=2026-10-08T08:37:43",{"Name":41,"Url":565,"Width":43,"Height":83},"https://static.kurir.rs/api/