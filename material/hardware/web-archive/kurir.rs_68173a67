,"Height":59},"https://static.kurir.rs/api/v3/images/1024/2048/2465364?ts=2026-10-07T13:21:08",{"DocumentId":598,"Title":599,"ShortDescription":600,"ParentMenuItemName":63,"RootMenuItemName":64,"WebUrl":601,"DocumentTypeAlias":66,"MasterDocumentId":602,"ParentMenuItemId":68,"RootMenuItemId":69,"CommentsNumber":603,"LastEditDate":604,"PublishedDate":604,"PosterPhoto":605},10126582,"U PORUCI \"IZDALI STE NAS\" ČUJE SE DUBOKO RAZOČARANJE MLADIH IZ SRPSKE! Očekivali od svojih vršnjaka u Srbiji solidarnost, sad moraju da brane dostojanstvo i dom","Mladi u Republici Srpskoj ne duguju nikome izvinjenje za svoje poreklo i ne treba da se odriču svog identiteta da bi bili prihvaćeni, naglasio je Srđan Barac","https://www.kurir.rs/vesti/politika/10126582/poruka-mladih-iz-rs-izdali-ste-nas",1619711,24,"2026-10-07T16:35:50",{"ImageId":606,"Description":11,"CopyRight":29,"ImageUrl":607,"ThumbnailUrl":608,"MediumImageUrl":609,"AltText":610,"Variations":611},2674550,"https://static.kurir.rs/api/v3/images/2674550?ts=2026-10-07T16:31:49","https://static.kurir.rs/api/v3/images/2674550/thumbnail?ts=2026-10-07T16:31:49","https://static.kurir.rs/api/v3/images/2674550/medium?ts=2026-10-07T16:31:49","45.jpg",[612,614,617,620,623],{"Name":36,"Url":613,"Width":38,"Height":99},"https://static.kurir.rs/api/v3/images/108/216/2674550?ts=2026-10-07T16:31:49",{"Name":41,"Url":615,"Width":43,"Height":616},"https://static.kurir.rs/api/v3/images/226/452/2674550?ts=2026-10-07T16:31:49",112,{"Name":46,"Url":618,"Width":48,"Height":619},"https://static.kurir.rs/api/v3/images/468/936/2674550?ts=2026-10-07T16:31:49",232,{"Name":51,"Url":621,"Width":53,"Height":622},"https://static.kurir.rs/api/v3/images/688/1376/2674550?ts=2026-10-07T16:31:49",342,{"Name":56,"Url":624,"Width":58,"Height":625},"https://static.kurir.rs/api/v3/images/1024/2048/2674550?ts=2026-10-07T16:31:49",509,{"1":66,"8":21,"11":299,"29":627},"ExternalArticle",[68,324,629,630,500,603,631,632,302],14,20,403,7,12,264,"Top-News-Horizontal-Slider",{"isSidebar":307,"showHeader":307,"URLSuffix":637,"externalURLSuffix":637,"hideOnPaging":307,"showOnPagingOnly":307},"?utm_source=$domain$&utm_medium=mostread_carousel&utm_campaign=adria_internal",{"children":639,"Type":1023,"Template":11,"Properties":2023,"Name":11},[640,1026],{"children":641,"Type":1023,"Template":11,"Properties":1024,"Name":11},[642,783,789,793,798,802,851,854],{"Document":643,"Type":66,"Template":66,"Name":11},{"DocumentId":644,"Title":645,"ShortDescription":11,"Lead":11,"RootMenuItemId":69,"RootMenuItemName":64,"ParentMenuItemId":632,"ParentMenuItemName":223,"LastEditDate":646,"PublishedDate":647,"LastEditDateLongFormatted":648,"LastEditDateShortFormatted":649,"PosterPhoto":650,"CommentsNumber":673,"WebUrl":674,"DocumentElements":675,"MasterDocumentId":752,"Tags":753,"DocumentTypeAlias":66,"Breadcrumb":778},1672901,"DOBANOVCI NOVI SENJAK: Niče elitno naselje sa luksuznim vilama i bazenima","2017-10-01T00:00:00","2015-02-02T16:28:18","01.10.2017. / 00:00","01.10.2017.",{"ImageId":651,"Description":11,"CopyRight":652,"ImageUrl":653,"ThumbnailUrl":654,"MediumImageUrl":655,"AltText":656,"Variations":657},349530,"Wikipedia","https://static.kurir.rs/api/v3/images/349530?ts=2015-02-02T15:23:53","https://static.kurir.rs/api/v3/images/349530/thumbnail?ts=2015-02-02T15:23:53","https://static.kurir.rs/api/v3/images/349530/medium?ts=2015-02-02T15:23:53","dobanovci.jpg",[658,661,664,667,670],{"Name":36,"Url":659,"Width":38,"Height":660},"https://static.kurir.rs/api/v3/images/108/216/349530?ts=2015-02-02T15:23:53",47,{"Name":41,"Url":662,"Width":43,"Height":663},"https://static.kurir.rs/api/v3/images/226/452/349530?ts=2015-02-02T15:23:53",99,{"Name":46,"Url":665,"Width":48,"Height":666},"https://static.kurir.rs/api/v3/images/468/936/349530?ts=2015-02-02T15:23:53",205,{"Name":51,"Url":668,"Width":53,"Height":669},"https://static.kurir.rs/api/v3/images/688/1376/349530?ts=2015-02-02T15:23:53",301,{"Name":56,"Url":671,"Width":58,"Height":672},"https://static.kurir.rs/api/v3/images/1024/2048/349530?ts=2015-02-02T15:23:53",448,13,"https://www.kurir.rs/vesti/beograd/1672901/dobanovci-novi-senjak-nice-elitno-naselje-sa-luksuznim-vilama-i-bazenima",[676,680,684,687,695,697,699,723,725,726,728,736,737,739,740,742,743,745,746,748,749,751],{"Text":677,"Type":678,"Name":679},"Otmeni kraj opštine Surčin","TextLine","Subtitle",{"Text":681,"Type":682,"Name":683}," Prestižni deo trebalo bi da dobije vile i 15.000 stanovnika. U planu 14 novih ulica, dva parka, pijaca... ","TextEditor","Lead",{"Text":685,"Type":682,"Name":686}," \u003Cp>BEOGRAD - Dobanovci će postati otmeni kraj opštine Surčin, kome će pozavideti i stanovnici prestižnih prestoničkih naselja, jer će se tamo izgraditi luksuzne vile i apartmani sa obezbeđenjem na oko 13.000 kvadrata.\u003Cbr />\u003Cbr />Ovo mesto, kako stoji u Nacrtu plana generalne regulacije, dobiće oko 15.000 stanovnika, ali i kulturni centar, dva parka, salu za male sportove, otvoreni i zatvoreni bazen, pijacu..., pišu \u003Cstrong>\u003Ca href=\"http://www.novosti.rs/vesti/beograd.74.html:531945-Dobanovci-kao-Senjak\" target=\"_blank\">Novosti\u003C/a>\u003C/strong>.\u003C/p> ","Content",{"Name":686,"Type":688,"IndexPageElement":689},"IndexPageElement",{"BannerId":11,"Type":310,"Template":11,"Properties":690,"Name":11},{"BannerId":691,"SlotCodeMobile":692,"SlotDimentionsMobile":693,"ClassMobile":694,"lazyInSidebar":307,"OOP":307,"hideOnPaging":307,"showOnPagingOnly":307},"1545649311922-0","338515395/Kurir/kurir_mob_id2","300,250;336,280;320,50;250,250;320,100;fluid","placeholder250px articleBelowPoster clean-ad-wrapper",{"Text":696,"Type":682,"Name":686}," \u003Cp>\u003C/p> ",{"Text":698,"Type":682,"Name":686}," \u003Cfigure class=\"elWrap imgFull\"> ",{"Image":700,"Type":722,"Name":686},{"ImageId":701,"Description":11,"CopyRight":702,"ImageUrl":703,"ThumbnailUrl":704,"MediumImageUrl":705,"AltText":706,"Alignment":11,"Variations":707},349537,"Glas Javnosti","https://static.kurir.rs/api/v3/images/349537?ts=2015-02-02T15:26:22","https://static.kurir.rs/api/v3/images/349537/thumbnail?ts=2015-02-02T15:26:22","https://static.kurir.rs/api/v3/images/349537/medium?ts=2015-02-02T15:26:22","senjak.jpg",[708,711,714,716,719],{"Name":36,"Url":709,"Width":38,"Height":710},"https://static.kurir.rs/api/v3/images/108/216/349537?ts=2015-02-02T15:26:22",63,{"Name":41,"Url":712,"Width":43,"Height":713},"https://static.kurir.rs/api/v3/images/226/452/349537?ts=2015-02-02T15:26:22",131,{"Name":46,"Url":715,"Width":48,"Height":189},"https://static.kurir.rs/api/v3/images/468/936/349537?ts=2015-02-02T15:26:22",{"Name":51,"Url":717,"Width":53,"Height":718},"https://static.kurir.rs/api/v3/images/688/1376/349537?ts=2015-02-02T15:26:22",398,{"Name":56,"Url":720,"Width":58,"Height":721},"https://static.kurir.rs/api/v3/images/1024/2048/349537?ts=2015-02-02T15:26:22",593,"Image",{"Text":724,"Type":682,"Name":686}," \u003Cfigcaption>Foto: Glas javnosti\u003C/figcaption>\u003C/figure> ",{"Text":696,"Type":682,"Name":686},{"Text":727,"Type":682,"Name":686}," \u003Cp>Na površini od oko 1.400 hektara, u centralnom delu uzdignuće se više od pet miliona stambenih kvadrata. Osim stanova u srcu Dobanovaca, rekonstrukcijom Doma omladine, u ovu ustanovu \"useliće se\" mesna zajednica, policijska stanica i pošta. Još jednom obnovom, prostora na uglu Maršala Tita i Ive Lole Ribara, centar će dobiti pešački trg.\u003C/p> ",{"Name":686,"Type":688,"IndexPageElement":729},{"Script":11,"Type":730,"Template":688,"Properties":731,"Name":11},"Midas",{"Id":732,"src":733,"srcBiznis":734,"srcZdravlje":735,"disableOnCommentPage":307,"disableOnArticlePage":307,"hideWidgetHeader":307,"lazyInSidebar":307},"midasWidget__11538","https://cdn2.midas-network.com/Scripts/midasWidget-7-2198-12231.js","https://cdn2.midas-network.com/Scripts/midasWidget-9-1628-11538.js","https://cdn2.midas-network.com/Scripts/midasWidget-7-1933-11642.js",{"Text":696,"Type":682,"Name":686},{"Text":738,"Type":682,"Name":686}," \u003Cp>\u003Cstrong>Sremska gazela\u003C/strong>\u003C/p> ",{"Text":696,"Type":682,"Name":686},{"Text":741,"Type":682,"Name":686}," \u003Cp>S druge strane, oni koji su pošli u kupovinu biće u prilici da pazare na planiranoj zelenoj pijaci. Kroz ovo \"zgusnuto\" jezgro i dalje će vijugati postojeća saobraćajnica povezujući ga na severu sa Ugrinovcima i Batajnicom, a sa južne, Surčinom, Jakovom, Boljevcima i Obrenovcem. Ova putanja dobiće \"komšinicu\" kod petlje u Dobanovcima gde će niknuti novi put pod nazivom Sremska gazela.\u003Cbr />\u003Cbr />Odrasle sa dubokim džepom posebno će privući vile i stanovi rezidencijalnog karaktera, sa bazenima i sportskim terenima u dvorištima. U moru novina, kad plan bude realizovan, Dobanovce će presecati 14 novih ulica, dobiće i malu vatrogasnu stanicu, dve trafostanice, apoteke...\u003C/p> ",{"Text":696,"Type":682,"Name":686},{"Text":744,"Type":682,"Name":686}," \u003Cp>\u003Cstrong>Gradiće se dva vrtića\u003C/strong>\u003C/p> ",{"Text":696,"Type":682,"Name":686},{"Text":747,"Type":682,"Name":686}," \u003Cp>Mališane će obradovati vest da će biti preuređeno fudbalsko igralište, a nova sala za male sportove imaće i svlačionice i tribine. Za 350 najmlađih otvoriće se u blizini i dva vrtića.\u003C/p> ",{"Text":696,"Type":682,"Name":686},{"Text":750,"Type":682,"Name":686}," \u003Cp>\u003Cstrong>Moderno groblje\u003C/strong>\u003Cbr />\u003Cbr />Budući meštani naselja Dobanovci moraće da se sahranjuju na novom groblju u delu industrijske zone. Razlog je popunjenost postojeća dva, koja se i dalje mogu koristiti \"isključivo u porodičnim grobnicama\".\u003Cbr />\u003Cbr />\u003Cstrong>(Večernje novosti)\u003C/strong>\u003C/p> ",{"Text":696,"Type":682,"Name":686},265591,[754,758,762,766,770,774],{"TagId":755,"Name":756,"Url":757},2670,"dobanovci","https://www.kurir.rs/tag/2670/dobanovci",{"TagId":759,"Name":760,"Url":761},4664,"bazeni","https://www.kurir.rs/tag/4664/bazeni",{"TagId":763,"Name":764,"Url":765},6954,"elita","https://www.kurir.rs/tag/6954/elita",{"TagId":767,"Name":768,"Url":769},8960,"vile","https://www.kurir.rs/tag/8960/vile",{"TagId":771,"Name":772,"Url":773},27125,"senjak","https://www.kurir.rs/tag/27125/senjak",{"TagId":775,"Name":776,"Url":777},296048,"luskuz","https://www.kurir.rs/tag/296048/luskuz",[779,781],{"Name":64,"Url":780},"https://www.kurir.rs/vesti",{"Name":223,"Url":782},"https://www.kurir.rs/vesti/beograd",{"Type":784,"Template":11,"Properties":785,"Name":11},"DfpOOP",{"SlotCodeDesktop":786,"ClassDesktop":787,"BannerId":788,"hideOnPaging":307,"showOnPagingOnly":307},"338515395/Kurir/kurir_desk_btf_oop2","clean-ad-wrapper OOP-reset","1699974160359-0",{"Type":784,"Template":11,"Properties":790,"Name":11},{"SlotCodeDesktop":791,"ClassDesktop":787,"BannerId":792,"hideOnPaging":307,"showOnPagingOnly":307},"338515395/Kurir/kurir_desk_btf_oop","1696418965919-0",{"Url":794,"CmfTag":795,"TagId":796,"Type":797},"L3BhZ2VlbGVtZW50cy84OC9QcmV2aW91c05leHREb2N1bWVudC83L3YzP3JlZmVycmVyUGFnZVVybD0vdmVzdGkvYmVvZ3JhZC8xNjcyOTAxL2RvYmFub3ZjaS1ub3ZpLXNlbmphay1uaWNlLWVsaXRuby1uYXNlbGplLXNhLWx1a3N1em5pbS12aWxhbWEtaS1iYXplbmltYQ==","ignoreThis_","_Previous_Next_Article","AsyncPageElement",{"Type":799,"Template":11,"Properties":800,"Name":11},"ArticleTags",{"disableOnCommentPage":801},"True",{"MenuItems":803,"Type":847,"Template":848,"Properties":849,"Name":850},[804,811,817,823,829,835,841],{"MenuItemId":721,"MenuItemType":805,"Title":806,"Url":807,"ContentUrl":807,"Properties":808},"ExternalUrl","Viber","https://invite.viber.com/?g2=AQBje97dfv10wkyhVjUl4GrM1%2FBR32HVXqdMxvc8ZBy8sf1bKtfuhhXEfuME8Yqz&lang=sr",{"menuIcon":809,"DefaultDomain":810},"viber","https://www.kurir.rs",{"MenuItemId":812,"MenuItemType":805,"Title":813,"Url":814,"ContentUrl":814,"Properties":815},365,"Facebook","https://www.facebook.com/kuririnfo",{"menuIcon":816,"DefaultDomain":810},"facebook",{"MenuItemId":818,"MenuItemType":805,"Title":819,"Url":820,"ContentUrl":820,"Properties":821},367,"X","https://x.com/kurirvesti",{"menuIcon":