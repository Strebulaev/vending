<script>
  (function () {
    var STORAGE_PREFIX = 'module-load-recovery:';
    // Chromium names the module; Firefox and Safari only name the missing export
    var LINK_ERROR =
      /does not provide an export named|doesn't provide an export named|import not found|Importing binding name .* is not found/;
    var THEME_ASSET = /\/cdn\/shop\/t\/[^/]+\/assets\//;

    function onError(event) {
      var message = (event && event.message) || '';

      // Only the theme's own module scripts; app embeds and extensions are left alone
      if (!LINK_ERROR.test(message) || !THEME_ASSET.test((event && event.filename) || '')) {
        return;
      }

      var specifier = (message.match(/module '([^']+)'/) || [])[1];
      var chunkUrl = null;

      try {
        chunkUrl = specifier ? new URL(specifier, event.filename || location.href) : null;
      } catch (e) {
        chunkUrl = null;
      }

      if (chunkUrl && (chunkUrl.origin !== location.origin || !THEME_ASSET.test(chunkUrl.pathname))) {
        return;
      }

      var key = STORAGE_PREFIX + (chunkUrl ? chunkUrl.pathname : message);

      try {
        if (sessionStorage.getItem(key)) {
          return;
        }

        sessionStorage.setItem(key, String(Date.now()));
      } catch (e) {
        return;
      }

      var refreshed = chunkUrl
        ? fetch(chunkUrl.href, { cache: 'reload', credentials: 'same-origin' }).catch(function () {})
        : Promise.resolve();

      refreshed.then(function () {
        location.reload();
      });
    }

    window.addEventListener('error', onError);
  })();
</script>


