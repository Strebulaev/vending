    <script>
  (function () {
    const paramName = '_ct';

    function readCartCookie() {
      const match = document.cookie.match(/(?:^|;\s*)cart=([^;]*)/);

      return match ? match[1] : '';
    }

    function contributeCart(params) {
      const cartCookie = readCartCookie();

      // Passed on as-is: the cookie value is already percent-encoded and the receiving side
      // decodes it until stable.
      if (cartCookie) params.set(paramName, cartCookie);

      // A theme preview is stored in the host-only `_shopify_essential` cookie, so without
      // this the switch silently drops back to the live theme. All domains are one store, so
      // the theme id is valid on the other side.
      const theme = window.Shopify && window.Shopify.theme;

      if (theme && theme.id && theme.role !== 'main') params.set('preview_theme_id', theme.id);
    }

    function normalizeCartCookieValue(value) {
      let decoded = value || '';

      // Shopify stores the cookie as `<token>%3Fkey%3D<key>`. Depending on how often the
      // value gets decoded on its way through the /localization redirect chain it can arrive
      // in either form, so decode until stable and rebuild the canonical value.
      for (let index = 0; index < 3 && decoded.indexOf('%') !== -1; index += 1) {
        try {
          const next = decodeURIComponent(decoded);

          if (next === decoded) {
            break;
          }

          decoded = next;
        } catch (_error) {
          break;
        }
      }

      // Strict on purpose: it validates the shape and stops a crafted `_ct` from smuggling
      // extra attributes into the cookie.
      const match = decoded.match(/^([A-Za-z0-9]+)(?:\?key=([A-Za-z0-9]+))?$/);

      if (!match) {
        return '';
      }

      return match[2] ? match[1] + '%3Fkey%3D' + match[2] : match[1];
    }

    function adoptHandedOverCart() {
      if (window.location.search.indexOf(paramName + '=') === -1) {
        return;
      }

      const params = new URLSearchParams(window.location.search);
      const cartCookieValue = normalizeCartCookieValue(params.get(paramName));

      params.delete(paramName);

      const query = params.toString();
      const cleanUrl = window.location.pathname + (query ? '?' + query : '') + window.location.hash;

      if (cartCookieValue && cartCookieValue !== readCartCookie()) {
        // Mirrors the attributes Shopify sets on the cart cookie itself: host-only, 90 days.
        document.cookie = 'cart=' + cartCookieValue + '; path=/; max-age=7776000';

        // The page was rendered server-side against the old cart, so it has to be re-fetched.
        // This reload is also what reprices the cart when the hop crossed a market (e.g.
        // US -> GB): a cart keeps the currency it was created in until a full page render
        // picks it up in the new market. The Ajax cart endpoints do not do this.
        window.location.replace(cleanUrl);

        return;
      }

      // Already on this cart, or nothing usable to adopt: drop the parameter without paying
      // for a second page load. This is the normal path for a same-domain country change.
      window.history.replaceState({}, document.title, cleanUrl);
    }

    if (window.TamesonLocalizationReturnTo) {
      window.TamesonLocalizationReturnTo.register(contributeCart);
    }

    adoptHandedOverCart();
  })();
</script>

