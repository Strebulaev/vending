                [{"Feature":"Connection size","FeatureID":"TF000138","Sorter":1,"Tooltip":"Choose a connection size that matches the size of the pipe or hose it will be connected to. Alternatively, you can size the valve based on the Kv value for more accuracy.","Value":"1\/2 inch","ValueID":"EV004591"},{"Feature":"Connection type","FeatureID":"TF000137","Sorter":2,"Tooltip":"Type of connection used for the valve ports.","Value":"Inner thread cylindrical BSP-G","ValueID":"EV020235"},{"Feature":"Function","FeatureID":"TF000002","Sorter":3,"Tooltip":"The circuit function of a solenoid valve specifies how fluid will flow between the valve's ports when it is energized or de-energized.","Value":"Normally closed","ValueID":"TV000020"},{"Feature":"Voltage","FeatureID":"TF000195","Sorter":4,"Tooltip":"Choose the voltage required to operate the valve. AC stands for alternating current, DC for direct current.","Value":"24 V DC","ValueID":"EV021411"},{"Feature":"Material","FeatureID":"EC010261-EF022461","Sorter":5,"Tooltip":"Choose a housing material that is not corroded by the media and environment, and can withstand the temperatures and pressures. Check out our chemical resistance chart.","Value":"Stainless steel","ValueID":"EV000166"},{"Feature":"Seal material","FeatureID":"EC010261-EF022606","Sorter":6,"Tooltip":"The choice mostly depends on chemical resistance, temperature and pressure ratings. Use our chemical resistance chart to search for compatibility with specific substances.","Value":"EPDM","ValueID":"EV006730"},{"Feature":"Operating principle","FeatureID":"TF000004","Sorter":7,"Tooltip":"The operating principle of the solenoid valve.","Value":"Semi-direct","ValueID":"TV000026"},{"Feature":"Recommended for","FeatureID":"TF000271","Sorter":8,"Tooltip":"Type of fluid or gas that the valve is recommended for.","Value":"Water,Carbon dioxide,Alcohols,Demineralized water","ValueID":"EV004870,EV022289,TV001052,TV001055"},{"Feature":"Max pressure (bar)","FeatureID":"EC010261-EF025188","Sorter":10,"Tooltip":"Maximum pressure difference between the inlet and outlet port.","Value":"10","ValueID":"10"},{"Feature":"Kv value [m3\/h]","FeatureID":"EC010261-EF022466","Sorter":11,"Tooltip":"Kv is a measure of the flow rate of water in m3\/h at a pressure drop of 1bar. Use the Kv calculator to calculate the required Kv for your application. Imperial units: Cv=1.16xKv.","Value":"3.6","ValueID":"3.6"},{"Feature":"Approval","FeatureID":"TF000152","Sorter":13,"Tooltip":"Certifications or approvals indicating safety, quality, or performance standards met.","Value":"Drinking water","ValueID":"TV000240"},{"Feature":"Valve bore (mm)","FeatureID":"EC010261-EF022575","Sorter":15,"Tooltip":"The valve bore is the diameter of the orifice, which the media flows through. It has a high impact on the flow rate.","Value":"13","ValueID":"13"},{"Feature":"Min temperature (°C)","FeatureID":"EC010261-EF020077","Sorter":17,"Tooltip":"The minimum temperature of the fluid at which the valve can operate continuously.","Value":"-30","ValueID":"-30"},{"Feature":"Max temperature (°C)","FeatureID":"EC010261-EF020023","Sorter":18,"Tooltip":"The maximum temperature of the fluid at which the valve can operate continuously.","Value":"100","ValueID":"100"},{"Feature":"Electrical connection","FeatureID":"EC010261-EF003701","Sorter":19,"Tooltip":"Type of electrical connection used to connect a power supply to the valve.","Value":"DIN-A","ValueID":"EV022892"},{"Feature":"Degree of protection (IP)","FeatureID":"EC010261-EF005474","Sorter":20,"Tooltip":"The Ingress Protection (IP) rating indicating the product's resistance to dust and water, crucial for outdoor or harsh conditions.","Value":"IP65","ValueID":"EV006421"},{"Feature":"Nominal power (W)","FeatureID":"TEF00169","Sorter":21,"Tooltip":"Rated power consumption of the valve.","Value":"10","ValueID":"10"},{"Feature":"Valve ports\/positions","FeatureID":"TF000003","Sorter":32,"Tooltip":"Number of ports and positions, e.g. 2\/2-way means 2 ports (in\/out) and 2 positions (open\/closed)","Value":"2\/2 way","ValueID":"TV000023"},{"Feature":"Certificates","FeatureID":"TF000553","Sorter":50,"Tooltip":"Any certifications or approvals that the valve has received, such as CE or UL listings, which indicate compliance with safety and quality standards.","Value":"KTW-W270,DIN EN 1333","ValueID":"TV002052,TV002188"},{"Feature":"Model","FeatureID":"EC010261-EF000010","Sorter":90,"Tooltip":"Choose a model.","Value":"Straight","ValueID":"EV000164"},{"Feature":"Max. ambient temp. (°C)","FeatureID":"EC010261-EF020188","Sorter":100,"Tooltip":"The highest temperature at which the solenoid valve can operate safely and effectively without experiencing damage or failure.","Value":"55","ValueID":"55"},{"Feature":"Min. ambient temperature (°C)","FeatureID":"TEF20432","Sorter":102,"Tooltip":"The lowest ambient temperature at which the valve can operate reliably.","Value":"-30","ValueID":"-30"},{"Feature":"Actuation","FeatureID":"TF000365","Sorter":103,"Tooltip":"Valves can be actuated in 5 ways: manual, mechanical, electrical, hydraulical, or pneumatical.","Value":"Plunger","ValueID":"TV002045"},{"Feature":"Valve construction","FeatureID":"TF000464","Sorter":104,"Tooltip":"Is the valve complete and ready for operation, or does this serve as a replacement component?","Value":"Valve complete","ValueID":"TV002046"},{"Feature":"Degree of protection (NEMA)","FeatureID":"TF000518","Sorter":106,"Tooltip":"The level of protection provided by the valve's enclosure against dust, water, and other environmental factors, as defined by the National Electrical Manufacturers Association (NEMA).","Value":"4X","ValueID":"EV014040"},{"Feature":"Valve seat material","FeatureID":"TF000528","Sorter":111,"Tooltip":"The material used to create the valve seat, which can affect its resistance to wear, corrosion, and chemical exposure.","Value":"Stainless steel","ValueID":"EV000166"},{"Feature":"Sealing toward outside material","FeatureID":