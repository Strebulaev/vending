<!doctype html>
<html class="no-js no-touch" lang="en">
  <head>
    
    <script>
  (function () {
    if (window.TamesonLocalizationReturnTo) {
      return;
    }

    const localizationPath = '/localization';
    const contributors = [];

    function isLocalizationForm(form) {
      if (!(form instanceof HTMLFormElement)) return false;

      const action = form.getAttribute('action') || '';

      return action === localizationPath || action.indexOf(localizationPath + '?') === 0;
    }

    // Shopify only honors `return_to` while it stays a relative path, but not every localization
    // form on the page is ours and some set an absolute one (the Selecty popup does, and carries
    // its own parameters in it). Reducing such a value to its path keeps those parameters, where
    // replacing the whole value with the current location silently dropped them.
    function toRelativeReturnTo(value) {
      if (!value) return '';

      // Already a path. `//host/path` is not one - it reads as protocol-relative, so it goes
      // through the parse below and comes back as the path alone.
      if (value.charAt(0) === '/' && value.charAt(1) !== '/') return value;

      let url;

      try {
        // Resolved against the full URL rather than the origin, so a value that is only a query
        // string keeps the path it was relative to.
        url = new URL(value, window.location.href);
      } catch (_error) {
        return '';
      }

      if (url.protocol !== 'http:' && url.protocol !== 'https:') return '';

      // The leading slashes are collapsed for the same reason `//host/path` is not taken above.
      return url.pathname.replace(/^\/+/, '/') + url.search + url.hash;
    }

    function prepareCrossDomainReturnTo(form) {
      const returnToInput = form.querySelector('[name="return_to"]');

      if (!returnToInput) return;

      const base =
        toRelativeReturnTo(returnToInput.value) || window.location.pathname + window.location.search;
      // Split on the first delimiter each time: a '?' inside the query is not a second separator,
      // and the fragment is carried through rather than dropped in case a contributor's caller
      // put state in it.
      const hashIndex = base.indexOf('#');
      const hash = hashIndex === -1 ? '' : base.slice(hashIndex);
      const pathAndQuery = hashIndex === -1 ? base : base.slice(0, hashIndex);
      const queryIndex = pathAndQuery.indexOf('?');
      const path = queryIndex === -1 ? pathAndQuery : pathAndQuery.slice(0, queryIndex);
      const params = new URLSearchParams(queryIndex === -1 ? '' : pathAndQuery.slice(queryIndex + 1));

      contributors.forEach(function (contributor) {
        // One contributor throwing must not cost the others their parameter.
        try {
          contributor(params);
        } catch (_error) {
          console.error('Localization return_to contributor failed');
        }
      });

      const nextQuery = params.toString();

      returnToInput.value = (nextQuery ? path + '?' + nextQuery : path) + hash;
    }

    // Every country and language selector in the theme submits through `form.submit()` (the
    // header switcher, the cart page, the cart notification), and that never fires a submit
    // event. Hooking the method instead of the call sites keeps selectors added later covered,
    // and survives the header being re-rendered by the sections API. It also covers the switchers
    // an app renders, which is wanted: a visitor sent to another domain by the Selecty banner
    // loses their cart and their consent just the same. Those forms are not ours though, so
    // whatever they already put in `return_to` has to survive.
    const nativeSubmit = HTMLFormElement.prototype.submit;

    HTMLFormElement.prototype.submit = function () {
      if (isLocalizationForm(this)) prepareCrossDomainReturnTo(this);

      return nativeSubmit.apply(this, arguments);
    };

    // Native submits, e.g. pressing Enter inside the country search field.
    document.addEventListener(
      'submit',
      function (event) {
        if (isLocalizationForm(event.target)) prepareCrossDomainReturnTo(event.target);
      },
      true
    );

    window.TamesonLocalizationReturnTo = {
      register: function (contributor) {
        if (typeof contributor === 'function') contributors.push(contributor);
      },
    };
  })();
</script>

    
<script>
  (function () {
    const paramName = "_pc";
    const cookieName = "_pandectes_gdpr";
    const rawOwnDomains = ["https:\/\/tameson.com","https:\/\/tameson.co.uk","https:\/\/tameson.nl","https:\/\/tameson.de","https:\/\/tameson.es","https:\/\/tameson.fr"];
    // What the app stores the cookie for.
    const cookieMaxAge = 31536000;
    // A consent blob is a few hundred characters; anything past this is not one, and long
    // parameters are what makes `return_to` fall over.
    const maxValueLength = 1200;

    function readConsentCookie() {
      const match = document.cookie.match(new RegExp("(?:^|;\\s*)" + cookieName + "=([^;]*)"));

      return match ? match[1] : "";
    }

    function decodeUntilStable(value) {
      let decoded = value || "";

      // Depending on how often the value is decoded on its way through the redirect chain it
      // can arrive percent-encoded once, twice or not at all. Base64 never contains '%', so a
      // clean value exits on the first check.
      for (let index = 0; index < 3 && decoded.indexOf("%") !== -1; index += 1) {
        try {
          const next = decodeURIComponent(decoded);

          if (next === decoded) {
            break;
          }

          decoded = next;
        } catch (_error) {
          break;
        }
      }

      return decoded;
    }

    function toBase64Url(base64) {
      return base64.replace(/\+/g, "-").replace(/\//g, "_").replace(/=+$/, "");
    }

    function fromBase64Url(value) {
      const base64 = value.replace(/-/g, "+").replace(/_/g, "/");

      return base64 + "=".repeat((4 - (base64.length % 4)) % 4);
    }

    function toOrigin(url) {
      if (!url) return "";

      try {
        return new URL(url).origin;
      } catch (_error) {
        return "";
      }
    }

    const ownOrigins = rawOwnDomains
      .map(function (domain) {
        return toOrigin(String(domain).trim());
      })
      .filter(Boolean);

    function isOwnOrigin(url) {
      const origin = toOrigin(url);

      return Boolean(origin) && ownOrigins.indexOf(origin) !== -1;
    }

    // Structural only, and deliberately not a whitelist of statuses: it has to stop a malformed
    // blob from being written, not second-guess the app. Attribute smuggling is already
    // impossible, since the parameter is validated as base64url and the value is re-encoded.
    function parseConsent(base64) {
      if (!base64 || typeof window.atob !== "function") {
        return null;
      }

      let consent;

      try {
        consent = JSON.parse(window.atob(base64));
      } catch (_error) {
        return null;
      }

      if (!consent || typeof consent !== "object" || Array.isArray(consent)) {
        return null;
      }

      return typeof consent.status === "string" ? consent : null;
    }

    // An empty `status` is the placeholder the app writes on the first page view. Only a
    // non-empty one means the visitor answered the banner.
    function hasDecision(consent) {
      return Boolean(consent) && /^[a-z_]{1,20}$/.test(consent.status);
    }

    function readStoredConsent() {
      return parseConsent(decodeUntilStable(readConsentCookie()));
    }

    // The app stores the cookie on the registrable domain (`.tameson.com`), so a host-only write
    // would leave two cookies of the same name and let the older one win the read. Probing beats
    // a hardcoded list: tameson.co.uk has a two-label public suffix, and only the browser knows
    // which suffixes are real.
    function detectCookieDomain() {
      const labels = window.location.hostname.split(".");
      const probeName = "_tameson_cookie_domain_probe";
      const probePattern = new RegExp("(?:^|;\\s*)" + probeName + "=");

      for (let index = labels.length - 2; index >= 0; index -= 1) {
        const candidate = labels.slice(index).join(".");

        document.cookie = probeName + "=1; path=/; domain=" + candidate;

        if (probePattern.test(document.cookie)) {
          document.cookie = probeName + "=; path=/; max-age=0; domain=" + candidate;

          return candidate;
        }
      }

      return "";
    }

    function storeConsent(base64) {
      const cookieDomain = detectCookieDomain();

      // Clear a host-only variant first. Same name, different scope, both returned by
      // `document.cookie` - and the older one is read first.
      document.cookie = cookieName + "=; path=/; max-age=0";

      // Otherwise mirrors how the app stores it: path '/', percent-encoded, one year, Lax.
      document.cookie =
        cookieName +
        "=" +
        encodeURIComponent(base64) +
        "; path=/; max-age=" +
        cookieMaxAge +
        "; samesite=lax" +
        (cookieDomain ? "; domain=" + cookieDomain : "");
    }

    function contributeConsent(params) {
      const base64 = decodeUntilStable(readConsentCookie());

      if (!/^[A-Za-z0-9+/]+={0,2}$/.test(base64) || !hasDecision(parseConsent(base64))) {
        return;
      }

      const value = toBase64Url(base64);

      if (value.length > maxValueLength) return;

      params.set(paramName, value);
    }

    function adoptHandedOverConsent() {
      if (window.location.search.indexOf(paramName + "=") === -1) {
        return;
      }

      const params = new URLSearchParams(window.location.search);
      const handedOver = params.get(paramName);

      params.delete(paramName);

      const query = params.toString();
      const cleanUrl = window.location.pathname + (query ? "?" + query : "") + window.location.hash;

      // Stripped first and unconditionally: the parameter must not reach GTM's `page_location`,
      // and a rejected handoff must not stay behind in a URL the visitor can copy and share.
      window.history.replaceState({}, "", cleanUrl);

      // An answer the visitor already gave on this domain wins. Not the placeholder though, or
      // the handoff would only ever work on a domain they have never opened.
      if (hasDecision(readStoredConsent())) return;

      // Only a navigation that came from one of our own domains may carry consent. Without
      // this, any crafted link would grant consent on the visitor's behalf.
      if (!isOwnOrigin(document.referrer)) return;

      if (!handedOver || handedOver.length > maxValueLength || !/^[A-Za-z0-9_-]+$/.test(handedOver)) {
        return;
      }

      const base64 = fromBase64Url(handedOver);

      if (!hasDecision(parseConsent(base64))) return;

      storeConsent(base64);
    }

    if (window.TamesonLocalizationReturnTo) {
      window.TamesonLocalizationReturnTo.register(contributeConsent);
    }

    // Consent is only adopted for a top-level navigation the visitor made themselves. An embedded
    // document carrying the parameter is not one.
    if (window.self === window.top) {
      adoptHandedOverConsent();
    }
  })();
</script>

    <script>
  (function () {
    // 'n' necessary, 'f' forced, 'r' remember, 'o' once - must match Autodetect > behavior.
    const redirectBehavior = 'r';

    function contributeAutodetect(params) {
      params.set('_rb', redirectBehavior);
      params.set('_cdr', '1');
    }

    if (window.TamesonLocalizationReturnTo) {
      window.TamesonLocalizationReturnTo.register(contributeAutodetect);
    }
  })();
</script>


    
    
    
    
    
