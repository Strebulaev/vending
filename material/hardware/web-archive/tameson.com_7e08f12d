        addToCart:"Add to Cart",
        quantity:"Quantity"}
    },
    featureFlags: {
      displayTamesonPro:true,
      showPricesInclVAT:false,
      featureModal:false,
      etimValueTooltips:false,
      showAvailabilityFilter:true,
      //TODO: remove this feature flag after the one store migration
      oneStoreFeatures:true,
    },
    markets: {
      currentHandle: "usd-market"
    }
  };

  
</script>

