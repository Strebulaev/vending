    <script>
(function () {
    var pts = [{"name":"Ledine","lat":44.7972,"lng":20.3287,"count":2,"url":"https:\/\/www.prelicinvest.com\/stanovi?lokacija=ledine","img":"https:\/\/www.prelicinvest.com\/storage\/properties\/17973\/18883.webp"},{"name":"Miodraga Petrovi\u0107a \u010ckalje broj 2A","lat":44.798297,"lng":20.327625,"count":15,"url":"https:\/\/www.prelicinvest.com\/stanovi?lokacija=miodraga-oetrovica-ckalje-broj-2","img":"https:\/\/www.prelicinvest.com\/storage\/properties\/19074\/20176.webp"},{"name":"Miodraga Petrovi\u0107a \u010ckalje broj 25","lat":44.796226,"lng":20.328816,"count":8,"url":"https:\/\/www.prelicinvest.com\/stanovi?lokacija=miodraga-oetrovica-ckalje-broj-25","img":"https:\/\/www.prelicinvest.com\/storage\/properties\/19104\/21172.webp"},{"name":"Miodraga Petrovi\u0107a \u010ckalje broj 18","lat":44.796555,"lng":20.328288,"count":35,"url":"https:\/\/www.prelicinvest.com\/stanovi?lokacija=miodraga-petrovica-ckalje-broj-18","img":"https:\/\/www.prelicinvest.com\/storage\/properties\/6\/01M469H75AAGGRT1CK0P85Z0MV.webp"},{"name":"Oplena\u010dka broj 14","lat":44.797126,"lng":20.329304,"count":1,"url":"https:\/\/www.prelicinvest.com\/stanovi?lokacija=oplenacka-broj-14","img":"https:\/\/www.prelicinvest.com\/storage\/properties\/21820\/21834.webp"},{"name":"Oplena\u010dka broj 24","lat":44.797994,"lng":20.329071,"count":5,"url":"https:\/\/www.prelicinvest.com\/stanovi?lokacija=oplenacka-broj-24","img":"https:\/\/www.prelicinvest.com\/storage\/properties\/18880\/21234.webp"}];
    var el = document.getElementById('home-naselje-map');
    if (!window.L || !el || !pts.length) { return; }
    function init() {
        var map = L.map(el, { scrollWheelZoom: false, attributionControl: true });
        // 23.09.2026: CARTO basemap od skora trazi API kljuc (na plocicama je pisalo API KEY REQUIRED).
        // Presli smo na OSM plocice bez kljuca; tamni izgled pravi CSS filter na .leaflet-tile-pane.
        L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
            maxZoom: 19, attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>'
        }).addTo(map);
        var bounds = [];
        pts.forEach(function (p) {
            var icon = L.divIcon({
                className: '', iconSize: [38, 38], iconAnchor: [19, 19], popupAnchor: [0, -20],
                html: '<div style="width:38px;height:38px;border-radius:50%;display:grid;place-items:center;'
                    + 'background:#C8A24A;color:#0B0C0E;font:700 14px/1 Inter,sans-serif;border:2px solid #F4F1EA;'
                    + 'box-shadow:0 0 0 4px rgba(200,162,74,.25),0 4px 14px rgba(0,0,0,.55)">' + p.count + '</div>'
            });
            var html = '<div style="width:200px">'
                + (p.img ? '<img src="' + p.img + '" alt="" style="width:100%;height:112px;object-fit:cover;display:block">' : '')
                + '<div style="padding:10px 12px 12px;text-align:center;background:#fff">'
                + '<strong style="font-size:14px;color:#0B0C0E">' + p.name + '</strong>'
                + '<div style="color:#555;margin:3px 0 9px;font-size:12px">' + p.count + ' ' + (p.count === 1 ? 'nekretnina' : 'nekretnina u ponudi') + '</div>'
                + '<a href="' + p.url + '" style="display:inline-block;background:#C8A24A;color:#0B0C0E;padding:7px 14px;border-radius:9px;font-weight:700;text-decoration:none;font-size:13px">Pogledaj stanove &rarr;</a>'
                + '</div></div>';
            L.marker([p.lat, p.lng], { icon: icon }).addTo(map).bindPopup(html, { maxWidth: 200, minWidth: 200 });
            bounds.push([p.lat, p.lng]);
        });
        if (bounds.length > 1) { map.fitBounds(bounds, { padding: [50, 50], maxZoom: 16 }); }
        else { map.setView(bounds[0], 16); }
        setTimeout(function () { map.invalidateSize(); }, 200);
    }
    if (document.readyState !== 'loading') { init(); } else { document.addEventListener('DOMContentLoaded', init); }
})();
</script>
<script>
(function () {
    var btns = [].slice.call(document.querySelectorAll('[data-pwa-install]'));
    var help = document.querySelector('[data-pwa-help]');
    var installed = document.querySelector('[data-pwa-installed]');
    if (!btns.length) return;
    var standalone = window.matchMedia('(display-mode: standalone)').matches || window.navigator.standalone === true;
    if (standalone) { btns.forEach(function (b) { b.classList.add('hidden'); }); if (installed) installed.classList.remove('hidden'); return; }
    btns.forEach(function (b) {
        b.addEventListener('click', function () {
            var p = window.__deferredPrompt;
            if (p) { p.prompt(); p.userChoice.finally(function () { window.__deferredPrompt = null; }); }
            else if (help) { help.classList.toggle('hidden'); }
        });
    });
    window.addEventListener('appinstalled', function () {
        btns.forEach(function (b) { b.classList.add('hidden'); });
        if (help) help.classList.add('hidden');
        if (installed) installed.classList.remove('hidden');
    });
})();
</script>
