    <script>
        addEventListener('error', function (ev) {
            var el = ev.target;
            if (!el || el.tagName !== 'IMG' || el.dataset.retried) return;
            var src = el.currentSrc || el.src;
            if (!src) return;
            el.dataset.retried = '1';
            try {
                var u = new URL(src, location.href);
                u.searchParams.set('r', Date.now());
                el.removeAttribute('srcset'); // spreči da srcset ponovo izabere polomljeni kandidat
                el.src = u.href;
            } catch (e) {}
        }, true);
    </script>

     
