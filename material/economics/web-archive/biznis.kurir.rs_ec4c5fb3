iku","Visok pritisak je jedan od ključnih faktora rizika za srčanu slabost, a prof. dr Jorde objašnjava kod kojih pacijenata bi trebalo proveriti i genetiku.","https://biznis.kurir.rs/prevencija-kao-garancija/10118008/visok-pritisak-srcana-slabost-genetika",1614871,"2026-09-29T09:00:00",{"ImageId":2703,"Description":2704,"CopyRight":27,"ImageUrl":2705,"ThumbnailUrl":2706,"MediumImageUrl":2707,"AltText":2708,"Variations":2709},2666022,"Srčana slabost ponekad može značajno da napreduje pre nego što se pojave ozbiljni simptomi","https://static.kurir.rs/api/v3/images/2666022?ts=2026-09-27T21:13:20","https://static.kurir.rs/api/v3/images/2666022/thumbnail?ts=2026-09-27T21:13:20","https://static.kurir.rs/api/v3/images/2666022/medium?ts=2026-09-27T21:13:20","Srce.jpg",[2710,2712,2714,2716,2718],{"Name":34,"Url":2711,"Width":36,"Height":37},"https://static.kurir.rs/api/v3/images/108/216/2666022?ts=2026-09-27T21:13:20",{"Name":39,"Url":2713,"Width":41,"Height":42},"https://static.kurir.rs/api/v3/images/226/452/2666022?ts=2026-09-27T21:13:20",{"Name":44,"Url":2715,"Width":46,"Height":47},"https://static.kurir.rs/api/v3/images/468/936/2666022?ts=2026-09-27T21:13:20",{"Name":49,"Url":2717,"Width":51,"Height":52},"https://static.kurir.rs/api/v3/images/688/1376/2666022?ts=2026-09-27T21:13:20",{"Name":54,"Url":2719,"Width":56,"Height":57},"https://static.kurir.rs/api/v3/images/1024/2048/2666022?ts=2026-09-27T21:13:20",[1289],1940,{"title":2599,"column":1295,"contentSection":2723,"additionalRightMargin":306,"isSidebar":916,"showHeader":916,"url":2724,"titleArrowColorLight":1837,"titleArrowColorDark":1689,"hideOnPaging":306,"showOnPagingOnly":306},"biznis","https://biznis.kurir.rs/odrziva-buducnost",{"Script":11,"Type":703,"Template":2726,"Properties":2727,"Name":11},"Midas-BCC",{"Id":2728,"src":2729,"disableOnCommentPage":306,"disableOnArticlePage":306,"hideWidgetHeader":306,"lazyInSidebar":306},"midasWidget__11537","https://cdn2.midas-network.com/Scripts/midasWidget-9-1627-11537.j