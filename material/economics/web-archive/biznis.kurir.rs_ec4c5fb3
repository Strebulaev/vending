3/images/2543929/thumbnail?ts=2026-04-23T20:27:30","https://static.kurir.rs/api/v3/images/2543929/medium?ts=2026-04-23T20:27:30","LOZNICA -U Loznici.JPG",[650,653,656,659,662],{"Name":34,"Url":651,"Width":36,"Height":652},"https://static.kurir.rs/api/v3/images/108/216/2543929?ts=2026-04-23T20:27:30",81,{"Name":39,"Url":654,"Width":41,"Height":655},"https://static.kurir.rs/api/v3/images/226/452/2543929?ts=2026-04-23T20:27:30",170,{"Name":44,"Url":657,"Width":46,"Height":658},"https://static.kurir.rs/api/v3/images/468/936/2543929?ts=2026-04-23T20:27:30",351,{"Name":49,"Url":660,"Width":51,"Height":661},"https://static.kurir.rs/api/v3/images/688/1376/2543929?ts=2026-04-23T20:27:30",516,{"Name":54,"Url":663,"Width":56,"Height":664},"https://static.kurir.rs/api/v3/images/1024/2048/2543929?ts=2026-04-23T20:27:30",768,"https://biznis.kurir.rs/info-biz/9976926/predstavljen-program-za-pocetnike-u-poslovanju",[667,672],{"FirstName":668,"LastName":669,"AuthorId":670,"PhotoUrl":11,"AuthorUrl":671,"AuthorTypeId":293,"Hidden":5},"T.","Ilić",15857,"https://biznis.kurir.rs/autor/15857/t-ilic",{"FirstName":673,"LastName":674,"AdditionalInfo":675,"AuthorTypeId":293,"Hidden":23},"\n+\b\u000f","\u0012+\u0007ċPţ","Urednik na portalu Kurir.rs. Novinarsko iskustvo počeo da stiče 2000. u dopisničkoj službi Sportskog žurnala, a od 2003. u tom dnevnom listu pratio dešavanja u FK Partizan. Na portalu Mondo, u sportskoj rubrici, radio od 2008. do 2013. Izveštavao s brojnih velikih sportskih događaja, pretežno fudbalskih, ali i drugih sportova. Na portalu Kurir.rs je od 2014. godine do danas - do 2020. u sportskoj rubrici, a potom u informativnoj. Od 2013. do 2022. neprekidno radio na izradi magazina sportske kladionice PINN BET, u međuvremenu i kao spoljni saradnik magazina Sport & Life, Mozzartsport...",[677,687,691,699,701,709,727,729,731,749,750,752,754,870,871,875,878,881],{"Image":678,"Type":685,"Name":686},{"ImageId":643,"Description":11,"CopyRight":644,"ImageUrl":645,"ThumbnailUrl":646,"MediumImageUrl":647,"AltText":648,"Alignment":11,"Variations":679},[680,681,682,683,684],{"Name":34,"Url":651,"Width":36,"Height":652},{"Name":39,"Url":654,"Width":41,"Height":655},{"Name":44,"Url":657,"Width":46,"Height":658},{"Name":49,"Url":660,"Width":51,"Height":661},{"Name":54,"Url":663,"Width":56,"Height":664},"Image","Big Image",{"Text":688,"Type":689,"Name":690}," \u003Cp>Prezentacija \"Programa za početnike u poslovanju (Program START UP)\", koji \u003Ca href=\"https://kurir.rs/tag/718/privredna-komora-srbije\" target=\"_blank\">Privredna komora Srbije\u003C/a> sprovodi u partnerstvu sa Srpskom fondacijom za preduzetništvo (SEF), održana je u četvrtak u \u003Ca href=\"https://kurir.rs/tag/466130/loznica\" target=\"_blank\">lozničkom\u003C/a> Inovacionom centru. Skup je organizovala Privredna komora Srbije (PKS), odnosno Regionalna privredna komora Kolubarskog i Mačvanskog upravnog okruga, a uz podršku Vlade Nemačke i nemačke razvojne banke KFV (KfW). za mlade preduzetnike i one koji tek žele da uplove u biznis vode.\u003C/p> ","TextEditor","Content",{"Name":690,"Type":692,"IndexPageElement":693},"IndexPageElement",{"BannerId":11,"Type":308,"Template":11,"Properties":694,"Name":11},{"BannerId":695,"SlotCodeMobile":696,"SlotDimentionsMobile":697,"ClassMobile":698,"lazyInSidebar":306,"OOP":306,"hideOnPaging":306,"showOnPagingOnly":306},"1545649311922-0","338515395/Kurir/kurir_mob_id2","300,250;336,280;320,50;250,250;320,100;fluid","placeholder250px articleBelowPoster clean-ad-wrapper",{"Text":700,"Type":689,"Name":690}," \u003Cp>\"Program za početnike u poslovanju\" predstavila je Milana Vujović iz PKS-Centar za programe podrške MMSPD i preduzetništvu, koja je rekla da je počeo 23. marta, a sada ga detaljnije predstavljaju zainteresovanima.\u003C/p> ",{"Name":690,"Type":692,"IndexPageElement":702},{"Script":11,"Type":703,"Template":692,"Properties":704,"Name":11},"Midas",{"Id":705,"src":706,"srcBiznis":707,"srcZdravlje":708,"disableOnCommentPage":306,"disableOnArticlePage":306,"hideWidgetHeader":306,"lazyInSidebar":306},"midasWidget__11538","https://cdn2.midas-network.com/Scripts/midasWidget-7-2198-12231.js","https://cdn2.midas-network.com/Scripts/midasWidget-9-1628-11538.js","https://cdn2.midas-network.com/Scripts/midasWidget-7-1933-11642.js",{"Image":710,"Type":685,"Name":690},{"ImageId":711,"Description":11,"CopyRight":644,"ImageUrl":712,"ThumbnailUrl":713,"MediumImageUrl":714,"OpenLinkInNewTab":23,"AltText":715,"Alignment":11,"Variations":716},2543927,"https://static.kurir.rs/api/v3/images/2543927?ts=2026-04-23T20:27:27","https://static.kurir.rs/api/v3/images/2543927/thumbnail?ts=2026-04-23T20:27:27","https://static.kurir.rs/api/v3/images/2543927/medium?ts=2026-04-23T20:27:27","LOZNICA -Predstavljanje programa.JPG",[717,719,721,723,725],{"Name":34,"Url":718,"Width":36,"Height":652},"https://static.kurir.rs/api/v3/images/108/216/2543927?ts=2026-04-23T20:27:27",{"Name":39,"Url":720,"Width":41,"Height":655},"https://static.kurir.rs/api/v3/images/226/452/2543927?ts=2026-04-23T20:27:27",{"Name":44,"Url":722,"Width":46,"Height":658},"https://static.kurir.rs/api/v3/images/468/936/2543927?ts=2026-04-23T20:27:27",{"Name":49,"Url":724,"Width":51,"Height":661},"https://static.kurir.rs/api/v3/images/688/1376/2543927?ts=2026-04-23T20:27:27",{"Name":54,"Url":726,"Width":56,"Height":664},"https://static.kurir.rs/api/v3/images/1024/2048/2543927?ts=2026-04-23T20:27:27",{"Text":728,"Type":689,"Name":690}," \u003Cp>\u003C/p> ",{"Text":730,"Type":689,"Name":690}," \u003Cp>- Namenjen je svima koji imaju poslovne ideje, sastoji se iz povoljnih bankarskih kredita i petodnevne obuke za pisanje poslovno-investicionog plana, a zamišljen je da im se olakša komplikovana procedura početka poslovanja, olakša ulazak u preduzetništvo. Maksimalni iznos traženih sredstava je 30.000 evra, krediti se mogu koristiti za investiciona ulaganja i operativne troškove, uz mogućnost grejs perioda. Kroz ovaj program se ne dobija samo finansijska nego i stručna podrška, ukoliko ste u fazi razmišljanja da započnete posao, ili da razradite već postojeći. Tu smo da im kroz petodnevnu besplatnu obuku, koja se održava onlajn putem platform za učenje na daljinu, pomognemo da upoznaju tržište, formiraju svoju cenu, da kroz korisne alate nauče sve što im je potrebno, kao i da održe svoju poslovnu ideju održivom na duže staze – kazala je ona i navela da svi zainteresovani za obuku mogu da se prijave putem mejl adrese: \u003Ca href=\"mailto:startup@pks.rs\">startup@pks.rs\u003C/a>. \u003C/p> ",{"Image":732,"Type":685,"Name":690},{"ImageId":733,"Description":11,"CopyRight":644,"ImageUrl":734,"ThumbnailUrl":735,"MediumImageUrl":736,"OpenLinkInNewTab":23,"AltText":737,"Alignment":11,"Variations":738},2543925,"https://static.kurir.rs/api/v3/images/2543925?ts=2026-04-23T20:27:24","https://static.kurir.rs/api/v3/images/2543925/thumbnail?ts=2026-04-23T20:27:24","https://static.kurir.rs/api/v3/images/2543925/medium?ts=2026-04-23T20:27:24","LOZNICA -Milana iz PKS.JPG",[739,741,743,745,747],{"Name":34,"Url":740,"Width":36,"Height":652},"https://static.kurir.rs/api/v3/images/108/216/2543925?ts=2026-04-23T20:27:24",{"Name":39,"Url":742,"Width":41,"Height":655},"https://static.kurir.rs/api/v3/images/226/452/2543925?ts=2026-04-23T20:27:24",{"Name":44,"Url":744,"Width":46,"Height":658},"https://static.kurir.rs/api/v3/images/468/936/2543925?ts=2026-04-23T20:27:24",{"Name":49,"Url":746,"Width":51,"Height":661},"https://static.kurir.rs/api/v3/images/688/1376/2543925?ts=2026-04-23T20:27:24",{"Name":54,"Url":748,"Width":56,"Height":664},"https://static.kurir.rs/api/v3/images/1024/2048/2543925?ts=2026-04-23T20:27:24",{"Text":728,"Type":689,"Name":690},{"Text":751,"Type":689,"Name":690}," \u003Cp>Cilj Programa podrške, u kome, kao partnerske banke učestvuju Halkbank, ProCredit Bank, 3Bank, Erste Bank, NLB Komercijalna banka i OTP Banka, jeste da doprinese stvaranju stimulativnog ambijenta za početnike u poslovanju, unapređenje uslova poslovanja u sektoru MMSP i preduzetništva i otvaranju novih malih i srednjih preduzeća i preduzetničkih radnji, u skladu sa strategijom Vlade Srbije.\u003C/p> ",{"Text":753,"Type":689,"Name":690}," \u003Cp>Ciljna grupa Programa su početnici u poslovanju i privredni subjekti ne stariji od tri godine, odnosno do 48 meseci ukoliko je većinski vlasnik žena, kao i fizička lica koja planiranju pokretanje poslovanja. Sastoji se iz petodnevnih besplatnih interaktivna obuka za izradu poslovno-investicionog plana koji organizuje Privredna komora Srbije, garancija za kredite koje će odobriti izabrane poslovne banke koje pokrivaju 60 odsto svakog individualnog kredita uključujući iznos redovne kamate, povoljnih bankarski kredita u maksimalnom iznosu od 3,6 miliona dinara, kao i bespovratnih sredstava (granta) korisnicima kredita koji ispune uslove programa u iznosu do 20 odsto od ukupnog investicionog ulaganja koje se finansira u okviru programa, dok je maksimalan iznos bespovratnih sredstava 360.000 dinara.\u003Cbr />Deo mladih lozničkih preduzetnika iskoristio je priliku da čuje savete kako da unapredi postojeće poslovanje, ili kako da što lakše krenu u biznis i realizuju poslovne ideje.\u003C/p> ",{"RelatedNewsTitle":755,"RelatedNewsTemplate":11,"Alignment":11,"RelatedNewsElements":756,"Type":869,"Name":690,"lastRelatedNewsElement":23},"Ne propustite",[757,786,813,844],{"Document":758,"Url":762,"Title":760},{"DocumentId":759,"Title":760,"ShortDescription":761,"ParentMenuItemName":184,"RootMenuItemName":184,"WebUrl":762,"DocumentTypeAlias":20,"MasterDocumentId":763,"ParentMenuItemId":187,"RootMenuItemId":187,"LastEditDate":764,"PublishedDate":764,"PosterPhoto":765},9976753,"\"JEDNOSTAVNOST ĆE POBEDITI\" Mariano Gomide, čovek iza platforme koju koristi više od 2.200 globalnih brendova, o sledećoj fazi e-trgovine","Šta smo saznali o trgovini budućnosti od Mariana Gomide de Farie, suosnivača VTEX-a, platforme na kojoj danas posluje više od 2.200 globalnih brendova i trgovinskih lanaca, među kojima su Walmart, Carrefour, Sony, Colgate, OBI…","https://biznis.kurir.rs/info-biz/9976753/mariano-gomide-jednostavnost-kao-kljuc-e-trgovine",1537179,"2026-04-23T16:14:17",{"ImageId":766,"Description":11,"CopyRight":27,"ImageUrl":767,"ThumbnailUrl":768,"MediumImageUrl":769,"AltText":770,"Variations":771},2543818,"https://static.kurir.rs/api/v3/images/2543818?ts=2026-04-23T16:06:34","https://static.kurir.rs/api/v3/images/2543818/thumbnail?ts=2026-04-23T16:06:34","https://static.kurir.rs/api/v3/images/2543818/medium?ts=2026-04-23T16:06:34","Mariano Gomide",[772,774,777,780,784],{"Name":34,"Url":773,"Width":36,"Height":168},"https://static.kurir.rs/api/v3/images/108/216/2543818?ts=2026-04-23T16:06:34",{"Name":39,"Url":775,"Width":41,"Height":776},"https://static.kurir.rs/api/v3/images/226/452/2543818?ts=2026-04-23T16:06:34",157,{"Name":44,"Url":778,"Width":46,"Height":779},"https://static.kurir.rs/api/v3/images/468/936/2543818?ts=2026-04-23T16:06:34",325,{"Name":49,"Url":781,"Width":782,"Height":783},"https://static.kurir.rs/api/v3/images/688/1376/2543818?ts=2026-04-23T16:06:34",578,401,{"Name":54,"Url":785,"Width":782,"Height":783},"https://static.kurir.rs/api/v3/images/1024/2048/2543818?ts=2026-04-23T16:06:34",{"Document":787,"Url":791,"Title":789},{"DocumentId":788,"Title":789,"ShortDescription":790,"ParentMenuItemName":184,"RootMenuItemName":184,"WebUrl":791,"DocumentTypeAlias":20,"MasterDocumentId":792,"ParentMenuItemId":187,"RootMenuItemId":187,"LastEditDate":793,"PublishedDate":793,"PosterPhoto":794},9976715,"Stiže novo jeftinije gorivo na pumpe! Liči na dizel, i može rešiti sve probleme sa visokim cenama - Koristiće se širom Evrope","Dok cene goriva nastavljaju da rastu, tračak nade dolazi iz Brisela.","https://biznis.kurir.rs/info-biz/9976715/novo-gorivo-e20-cene-dizel-nestasica-benzin",1537158,"2026-04-23T15:43:19",{"ImageId":795,"Description":796,"CopyRight":27,"ImageUrl":797,"ThumbnailUrl":798,"MediumImageUrl":799,"AltText":800,"Variations":801},2240346,"Benzinska pumpa, sipanje goriva","https://static.kurir.rs/api/v3/images/2240346?ts=2025-06-10T12:02:16","https://static.kurir.rs/api/v3/images/2240346/thumbnail?ts=2025-06-10T12:02:16","https://static.kurir.rs/api/v3/images/2240346/medium?ts=2025-06-10T12:02:16","shutterstock_370455869.jpg",[802,804,806,808,810],{"Name":34,"Url":803,"Width":36,"Height":37},"https://static.kurir.rs/api/v3/images/108/216/2240346?ts=2025-06-10T12:02:16",{"Name":39,"Url":805,"Width":41,"Height":42},"https://static.kurir.rs/api/v3/images/226/452/2240346?ts=2025-06-10T12:02:16",{"Name":44,"Url":807,"Width":46,"Height":47},"https://static.kurir.rs/api/v3/images/468/936/2240346?ts=2025-06-10T12:02:16",{"Name":49,"Url":809,"Width":51,"Height":52},"https://static.kurir.rs/api/v3/images/688/1376/2240346?ts=2025-06-10T12:02:16",{"Name":54,"Url":811,"Width":495,"Height":812},"https://static.kurir.rs/api/v3/images/1024/2048/2240346?ts=2025-06-10T12:02:16",667,{"Document":814,"Url":818,"Title":816},{"DocumentId":815,"Title":816,"ShortDescription":817,"ParentMenuItemName":184,"RootMenuItemName":184,"WebUrl":818,"DocumentTypeAlias":20,"MasterDocumentId":819,"ParentMenuItemId":187,"RootMenuItemId":187,"LastEditDate":820,"PublishedDate":820,"PosterPhoto":821},9976690,"Veliki planovi za Sremsku Mitrovicu: Kineska delegacija s gradonačelnikom Nedimovićem o mogućim ulaganjima","Sremska Mitrovica ponovo je u fokusu stranih investitora, a ovog puta interesovanje stiže iz Kine.","https://biznis.kurir.rs/info-biz/9976690/sremska-mitrovica-kineska-ulaganja-u-industriju",1537145,"2026-04-23T15:21:14",{"ImageId":822,"Description":11,"CopyRight":27,"ImageUrl":823,"ThumbnailUrl":824,"MediumImageUrl":825,"AltText":826,"Variations":827},2543792,"https://static.kurir.rs/api/v3/images/2543792?ts=2026-04-23T15:17:50","https://static.kurir.rs/api/v3/images/2543792/thumbnail?ts=2026-04-23T15:17:50","https://static.kurir.rs/api/v3/images/2543792/medium?ts=2026-04-23T15:17:50","Branislav Nedimović",[828,831,834,837,840],{"Nam