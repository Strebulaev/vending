.zlf .zlinks a{transition:color 180ms}
.zlf .zlinks a:hover,.zlf .zlinks a:focus-visible{color:var(--gl)}
.zlf .zsoc{display:flex;gap:9px;margin-top:26px;flex-wrap:wrap}
.zlf .zsoc a{width:36px;height:36px;border:1px solid var(--zline);border-radius:6px;display:flex;align-items:center;justify-content:center;font-size:15px;color:rgba(255,255,255,.62);transition:color 180ms,border-color 180ms,background 180ms}
.zlf .zsoc a:hover,.zlf .zsoc a:focus-visible{color:#fff;border-color:var(--gl);background:rgba(89,187,178,.16)}

.zlf .zllm{border-top:1px solid var(--zline);border-bottom:1px solid var(--zline)}
.zlf .zllm .zin{display:flex;align-items:center;gap:22px;padding-top:20px;padding-bottom:20px;flex-wrap:wrap}
.zlf .zllm .zt{font-size:14px;color:rgba(255,255,255,.62)}
.zlf .zllm .zt b{color:#fff;font-weight:600}
.zlf .zllm .zbtns{display:flex;gap:8px;flex-wrap:wrap}
.zlf .zllm .zbtns a{display:inline-flex;align-items:center;gap:7px;font-size:12.5px;font-weight:500;color:rgba(255,255,255,.72);background:rgba(255,255,255,.05);border:1px solid var(--zline);border-radius:6px;padding:8px 14px;transition:color 180ms,border-color 180ms}
.zlf .zllm .zbtns a:hover,.zlf .zllm .zbtns a:focus-visible{color:#fff;border-color:var(--gl)}
.zlf .zllm .zbtns svg{font-size:13px;color:var(--gl)}

.zlf .zbot .zin{display:flex;align-items:center;justify-content:space-between;gap:24px;padding-top:26px;padding-bottom:30px;flex-wrap:wrap}
.zlf .zmark{font-size:22px;font-weight:300;letter-spacing:.11em;line-height:1;color:#fff;white-space:nowrap}
.zlf .zmark b{font-weight:300;color:var(--gl)}
.zlf .zbot-r{display:flex;align-items:center;gap:24px;flex-wrap:wrap;justify-content:flex-end}
.zlf .zlegal{display:flex;gap:26px;font-size:13px;color:rgba(255,255,255,.65);flex-wrap:wrap}
.zlf .zlegal a{transition:color 180ms}
.zlf .zlegal a:hover,.zlf .zlegal a:focus-visible{color:var(--gl)}
.zlf .zpref{display:inline-flex;align-items:center;gap:9px;font-size:12.5px;font-weight:500;color:rgba(255,255,255,.78);border:1px solid var(--gl);border-radius:100px;padding:9px 16px;transition:color 180ms,border-color 180ms,background 180ms}
.zlf .zpref:hover,.zlf .zpref:focus-visible{color:#fff;border-color:var(--gl);background:rgba(255,255,255,.07)}
.zlf .zpref svg{font-size:14px;color:var(--gl)}
.zlf .zcopy{font-size:12.5px;color:rgba(255,255,255,.5);padding-bottom:26px;text-align:center}

@media (max-width:1080px){.zlf .zmain{grid-template-columns:1fr 1fr;gap:40px}}
@media (max-width:640px){.zlf .zmain{grid-template-columns:1fr}.zlf .zin{padding:0 22px}.zlf .zcta h2{font-size:21px}
  .zlf .zoffice .zrows .zrow:first-child{min-height:0}
  .zlf .zbot .zin,.zlf .zbot-r{justify-content:flex-start}}
