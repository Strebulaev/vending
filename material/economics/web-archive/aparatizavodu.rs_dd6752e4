<script data-used_fonts="Noto+Sans:400,400i,700,700i">
  (function() {
    const originUsedFonts = 'Noto+Sans:400,400i,700,700i';
    const usedFontsFamilies = originUsedFonts.split(' | ');
    const usedFontsUrl = originUsedFonts.replaceAll(' ', '');

    if ('Noto+Sans:400,400i,700,700i') {
      WebFontConfig = {
        custom: {
          families: usedFontsFamilies,
          urls:['https://fonts.sitebuilderhost.net/css?family=' + usedFontsUrl + '&display=swap']
        },
        classes: !1,
        events: !1
      },
      function(e) {
        var a = e.createElement('script'), s = e.head;
        a.src='https://cdnjs.cloudflare.com/ajax/libs/webfont/1.6.28/webfontloader.js', a.async = !0, s.appendChild(a, s)
      }(document);
    }
  })()
</script>
