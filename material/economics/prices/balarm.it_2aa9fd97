			margin-bottom: 12px;
			font-size: 13px;
			color: #666;
			text-align: center;
			width: 98%;
			line-height: 1.1;
		}

		.swiper-top-bar {
		display: flex;
		align-items: center;
		justify-content: center;
		position: relative;
		height: 40px;
		background-color: #fff;
