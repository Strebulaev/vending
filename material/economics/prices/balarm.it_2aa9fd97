		color: #333;
		}


		.swiper-pagination-custom {
		position: absolute;
		left: 10px;
		top: 50%;
		transform: translateY(-50%);
		font-weight: bold;
		}

		.swiper-pagination {
		display: flex !important;
		align-items: center;
		justify-content: center;
		transform: translateY(-3px); 
		}

		.swiper-pagination-bullet {
