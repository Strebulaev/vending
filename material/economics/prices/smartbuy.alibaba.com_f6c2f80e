<!-- Load Message Board Component -->
<script src="https://s.alicdn.com/@g/usergrowth-fe/seo-aigc-components/0.0.1/message-board/message-board.iife.js"></script>
<!-- Render Component -->
<script>
    // Get SDK instance
    const sdk = window.ComponentRenderSDK;
    // Register MessageBoard component
    if (typeof MessageBoard !== 'undefined') {
      sdk.register('MessageBoard', MessageBoard.default || MessageBoard);
    }
    let commentsData = [];
    try {
      sdk.render({
        containerId: 'message-board',
        component: {
          name: 'MessageBoard',
          props: {
            comments: commentsData,
            theme:{
              primaryColor: '#9c27b0',
              focusColor: '#9c27b0',
              textColor: '#333',
              borderColor: '#f3e5f5',
            },
            onSubmit: comment => {
              const newComment = {
                ...comment,
                id: Date.now().toString(),
                timestamp: new Date(),
                isApproved: false,
              };
              commentsData.unshift(newComment);
              updateStatus('status1', `New comment added by ${comment.name}`, 'success');
              // Re-render to show new comment
              renderMethod1();
            },
            onReply: commentId => {
              updateStatus('status1', `Reply clicked for comment ID: ${commentId}`, 'success');
            },
          },
        },
      })
    } catch (error) {
      console.error('Render error:', error);
    }
</script>

