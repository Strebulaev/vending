<script>
    (function(){
      const container = document.getElementById('ratingA');
      if(!container) return;
      const stars = Array.from(container.querySelectorAll('.star-a'));
      const msg = document.getElementById('msgA');
      const KEY = 'ilc_rating_A_' + location.hostname + location.pathname;
      let saved = null;

      // load
      try { const v = parseInt(localStorage.getItem(KEY),10); if(!isNaN(v)) saved = v; } catch(e){}

      function apply(n){
        stars.forEach(s => s.classList.toggle('on', parseInt(s.dataset.val,10) <= n));
      }
      function clearAll(){ stars.forEach(s => s.classList.remove('on')); }

      if(saved) apply(saved);

      stars.forEach(s=>{
        s.addEventListener('mouseenter', ()=> apply(parseInt(s.dataset.val,10)));
        s.addEventListener('mouseleave', ()=> saved ? apply(saved) : clearAll());
        s.addEventListener('click', ()=>{
          const v = parseInt(s.dataset.val,10);
          try{ localStorage.setItem(KEY, String(v)); saved = v; }catch(e){}
          apply(v);
          msg.textContent = ['Thanks for rating!','Thank you!','Appreciate it!','We value your feedback!','Perfect — thanks!'][v-1] || 'Thanks!';
        });
        s.addEventListener('keydown', (e)=> {
          if(e.key==='Enter' || e.key===' '){ e.preventDefault(); s.click(); }
        });
      });
    })();
</script>
