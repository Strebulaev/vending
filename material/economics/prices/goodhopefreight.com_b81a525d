<script>
// 滚动隐藏顶部栏
let lastScrollY = 0;
const topBar = document.getElementById('topBar');
window.addEventListener('scroll', () => {
    const currentScrollY = window.scrollY;
    if(currentScrollY > lastScrollY && currentScrollY > 10){
        topBar.classList.add('hide-bar');
    }else{
        topBar.classList.remove('hide-bar');
    }
    lastScrollY = currentScrollY;
});

// 移动端汉堡菜单切换
const toggleBtn = document.getElementById('toggleBtn');
const mainMenu = document.getElementById('mainMenu');
toggleBtn.addEventListener('click',()=>{
    mainMenu.classList.toggle('open');
});

// 语言下拉切换（点击展开/收起，点击外部关闭）
const langItem = document.getElementById('langItem');
const langToggle = document.getElementById('langToggle');
langToggle.addEventListener('click', (e) => {
    e.preventDefault();
    langItem.classList.toggle('open');
});
document.addEventListener('click', (e) => {
    if (!langItem.contains(e.target)) langItem.classList.remove('open');
});
</script>
<!-- Bootstrap 5 JS Bundle (collapse/accordion, etc.) -->
    <script src="https://goodhopefreight.com/js/goodhope-cookie-2026.js"></script>
