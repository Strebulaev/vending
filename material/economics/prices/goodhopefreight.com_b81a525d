<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "@id": "https://goodhopefreight.com/#faq",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What shipping methods do you offer from China?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "We offer sea freight (FCL & LCL), air freight, rail freight on the China-Europe Express, express courier (DHL, FedEx, UPS), and door-to-door Amazon FBA shipping. Tell us your cargo type, weight and destination, and our team will recommend the most cost-effective option."
      }
    },
    {
      "@type": "Question",
      "name": "How long does shipping from China take?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Transit times depend on the service and destination. As a general guide, express courier takes a few days, air freight around one week, and sea freight usually between 2 and 5 weeks depending on the port-to-port route. Our sales team will confirm the exact transit time when preparing your quote."
      }
    },
    {
      "@type": "Question",
      "name": "Can you ship lithium batteries and other dangerous goods?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Battery and dangerous goods shipping is one of our specialties. We handle lithium batteries, power banks, and other DG cargo with properly certified packaging and compliant documentation. Contact us with the battery type, watt-hour rating, and quantity for a feasibility check and rate."
      }
    },
    {
      "@type": "Question",
      "name": "Do you provide Amazon FBA shipping?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. We offer complete Amazon FBA head-haulage from China, including sea, air and rail options, plus warehouse booking, FBA labeling, palletization and delivery to Amazon fulfillment centers across the US, UK, EU, Canada, and other markets."
      }
    },
    {
      "@type": "Question",
      "name": "How do I get a freight quote?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Send us your cargo details - product name, weight, dimensions, quantity, pickup city in China and destination country - via email or WhatsApp. Our freight experts will get back to you with a tailored rate, usually within 24 hours."
      }
    },
    {
      "@type": "Question",
      "name": "Do you handle customs clearance and door-to-door delivery?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. We provide customs clearance support and can arrange door-to-door delivery to most countries worldwide, covering export documentation in China and import handling at the destination. Our team will guide you through the required documents for your specific goods."
      }
    }
  ]
}
</script>
