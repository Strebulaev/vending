            customerEmail: null,
            customerMetafields: null,
            cartAttributes: {}
        },
	{
    labels: {
      addVatNumber: "Add intra-community number",
      cancel: "Cancel",
      
      email: "Email",
      emailInvalid: "Email is invalid",
      emailRequired: "Email is required",
      exemptionFailed: "Exemption failed",
      save: "Save",
      validationFailed: "Validation failed",
      vatNumber: "VAT number",
      vatNumberInvalid: "VAT number is invalid",
      vatNumberNotExempt: "VAT number is not exempt",
      vatNumberRequired: "VAT number required",
      vatRegistered: "If your company has a valid EU VAT number, enter it here including the country code prefix (e.g. NL123456789B01 , SE987654321001). If validated successfully, VAT will be automatically removed."
    }
  });
        SufioVAT.onCustomerAccount();
        SufioVAT.onCart({
            selectors: "#cart-page-vat-form"
        });
        SufioVAT.onCustomerRegister();
    };
</script>
