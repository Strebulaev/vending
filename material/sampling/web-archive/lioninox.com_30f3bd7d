<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Seleccionamos el select dentro del contenedor con la clase 'product-form-input-dropdown'
    const selectElement = document.querySelector('.product-form-input-dropdown select');
    
    // Verificar que selectElement no sea null
    if (!selectElement) {
      console.error('El elemento select dentro de .product-form-input-dropdown no existe.');
      return; // Salimos del script si el elemento no existe
    }
  
    const customLiquidRightDivs = document.querySelectorAll('.custom-liquid-right div');
  
    // Función para mostrar el div correspondiente y ocultar los demás
    function handleSelectChange() {
      const selectedIndex = selectElement.selectedIndex; // Obtiene el índice de la opción seleccionada
      
      // Oculta todos los divs
      customLiquidRightDivs.forEach((div) => {
        div.style.display = 'none';
      });
  
      // Obtener el <p> dentro del div correspondiente
      const selectedDiv = customLiquidRightDivs[selectedIndex];
      const pElement = selectedDiv.querySelector('p'); // Selecciona el <p> dentro del div
  
      // Verificar si el <p> contiene la palabra 'SKU'
      if (pElement && pElement.textContent.includes('SKU')) {
        // Muestra el div si la verificación es verdadera
        selectedDiv.style.display = 'block';
      }
    }
  
    // Escucha el evento 'change' en el select
    selectElement.addEventListener('change', handleSelectChange);
  
    // Inicialmente, muestra solo el div correspondiente si cumple con la verificación
    handleSelectChange();
  });
  
</script>


