        ['home', 'collection'].includes(window?.__st?.p)) ||
      (ESTIMATED_SHOPS_GATE_SCRIPT_BY_PAGES.includes(estimatedShop) && !ESTIMATED_ALLOW_SCRIPT_ON_PAGE);

