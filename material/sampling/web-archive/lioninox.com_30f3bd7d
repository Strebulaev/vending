item will be back in stock on...\u003cbr\u003e🚚 Pre-order now for FREE delivery in 2-4 days once it’s in stock."}],"appearanceContent":{"id":304,"shop":"lioninox-shop.myshopify.com","timelineOrderStepTitle":"Order","timelineOrderStepDescription":"","timelineShipStepTitle":"Shipping","timelineShipStepDescription":"","timelineDeliveryStepTitle":"Delivery","timelineDeliveryStepDescription":"","inputLabel":"","inputPlaceholder":"","zipcodeAvailableText":"","zipcodeNotAvailableText":"","submitButton":"","days":"","hours":"","minutes":"","seconds":"","shippingMethodLabel":""},"checkoutContent":{"id":240,"shop":"lioninox-shop.myshopify.com","productTimeLine":"","thankYouAndOrderStatus":"","checkoutRules":[]},"shippingProtectionCartContent":null,"shippingProtectionCheckoutContent":null,"countryContents":[],"markets":[],"stateContents":[]}]});/* US-DSS-006 CR-2: mọi giá trị lặp (ở mọi field, mọi độ sâu) nằm ở app_data_shared_<i>; object chứa nó giữ $s = { field: index }. Bảng dùng chung resolve trước theo index tăng dần (entry i chỉ được tham chiếu j < i, chặn vòng), rồi resolve đệ quy rules + languages. Tham chiếu hỏng ở bất kỳ đâu, hoặc còn $s mà không có bảng dùng chung (core cũ + chunk mới bị lai), thì không tin chunk. */
      var shared = [];var hasOwn = function (node, key) {
        return Object.prototype.hasOwnProperty.call(node, key);
      };
      var resolvedShared = [];
      var resolveNode = function (node, limit, depth) {
        if (depth > 64) {
          isChunkSetValid = false;
          return node;
        }
        if (Array.isArray(node)) {
          for (var n = 0; n < node.length; n++) { node[n] = resolveNode(node[n], limit, depth + 1); }
          return node;
        }
        if (!node || typeof node !== 'object') { return node; }
        var hasRefs = hasOwn(node, '$s');
        var refs = node.$s;
        if (hasRefs) { delete node.$s; }
        for (var key in node) {
          if (hasOwn(node, key)) { node[key] = resolveNode(node[key], limit, depth + 1); }
        }
        if (!hasRefs) { return node; }
        if (!refs || typeof refs !== 'object' || Array.isArray(refs)) {
          isChunkSetValid = false;
          return node;
        }
        for (var field in refs) {
          if (!hasOwn(refs, field)) { continue; }
          var index = refs[field];
          if (typeof index !== 'number' || index % 1 !== 0 || index < 0 || index >= limit) {
            isChunkSetValid = false;
            continue;
          }
          /* Clone object/array: trước khi gom mỗi rule có bản riêng, giữ nguyên để code widget lỡ mutate không lan sang rule khác. */
          var value = resolvedShared[index];
          node[field] = value && typeof value === 'object' ? JSON.parse(JSON.stringify(value)) : value;
        }
        return node;
      };
      for (var s = 0; s < shared.length && isChunkSetValid; s++) {
        resolvedShared.push(resolveNode(shared[s], s, 0));
      }
      if (isChunkSetValid) {
        resolveNode(rules, resolvedShared.length, 0);
        resolveNode(languages, resolvedShared.length, 0);
        core.data.rules = rules;
        core.data.languages = languages;
      } else {
        core.manualData = true;
        delete core.data.rules;
        delete core.data.languages;
      }
    }
    delete core.chunks;

    window.estimatedAppMetafields = core;
  })();
</script>
