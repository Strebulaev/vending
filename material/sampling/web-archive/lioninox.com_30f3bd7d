      var shared = [];var hasOwn = function (node, key) {
        return Object.prototype.hasOwnProperty.call(node, key);
      };
      var resolvedShared = [];
      var resolveNode = function (node, limit, depth) {
        if (depth > 64) {
          isChunkSetValid = false;
          return node;
        }
        if (Array.isArray(node)) {
          for (var n = 0; n < node.length; n++) { node[n] = resolveNode(node[n], limit, depth + 1); }
          return node;
        }
        if (!node || typeof node !== 'object') { return node; }
        var hasRefs = hasOwn(node, '$s');
        var refs = node.$s;
        if (hasRefs) { delete node.$s; }
        for (var key in node) {
          if (hasOwn(node, key)) { node[key] = resolveNode(node[key], limit, depth + 1); }
        }
        if (!hasRefs) { return node; }
        if (!refs || typeof refs !== 'object' || Array.isArray(refs)) {
          isChunkSetValid = false;
          return node;
        }
        for (var field in refs) {
          if (!hasOwn(refs, field)) { continue; }
          var index = refs[field];
          if (typeof index !== 'number' || index % 1 !== 0 || index < 0 || index >= limit) {
            isChunkSetValid = false;
            continue;
          }
          /* Clone object/array: trước khi gom mỗi rule có bản riêng, giữ nguyên để code widget lỡ mutate không lan sang rule khác. */
          var value = resolvedShared[index];
          node[field] = value && typeof value === 'object' ? JSON.parse(JSON.stringify(value)) : value;
        }
        return node;
      };
      for (var s = 0; s < shared.length && isChunkSetValid; s++) {
        resolvedShared.push(resolveNode(shared[s], s, 0));
