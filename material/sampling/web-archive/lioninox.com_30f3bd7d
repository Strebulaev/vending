  text-align:center !important;
}
.add-to-cart-btn .spinner {
    border: 3px solid rgba(0, 0, 0, 0.1);
    border-top: 3px solid black;
    border-radius: 50%;
    width: 20px;
    height: 20px;
    animation: spin 1s linear infinite;
    display: inline-block;
    margin-left: 5px;
    margin-right: 5px;
}

@keyframes spin {
    0% {
        transform: rotate(0deg);
    }
    100% {
        transform: rotate(360deg);
    }
}
.diagonal-line{
  position:relative;
}
.diagonal-line::after {
  content: "";
  position: absolute;
  top: 44%;
  left: 0;
  width: 100%;
  height: 1px;
  border: 1px solid currentColor;
  opacity: .5;
  transform: rotate(-10deg);
}

</style>


<script>
document.addEventListener("DOMContentLoaded", function () {
    document.querySelectorAll(".add-to-cart-btn").forEach((button) => {
        button.addEventListener("click", function (event) {
            event.preventDefault();

            const variantId = this.getAttribute("data-variant-id");
            const quantityInput = document.querySelector(`input[name="quantity_${variantId}"]`);
            const quantity = quantityInput ? parseInt(quantityInput.value) : 1;

            if (!variantId || quantity < 1) {
                console.error("Error: Variante inválida o cantidad incorrecta.");
                return;
            }

            // Guardar el texto original y agregar el spinner
            const originalText = this.innerHTML;
            this.innerHTML = `<span class="spinner"></span>`;
            this.disabled = true;

            // Agregar el producto al carrito con la cantidad correcta
            fetch("/cart/add.js", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ id: variantId, quantity: quantity }),
            })
                .then((response) => {
                    if (!response.ok) {
                        throw new Error(`HTTP error! status: ${response.status}`);
                    }
                    return response.json();
                })
                .then((data) => {
                    console.log("Producto agregado al carrito:", data);

                    // Obtener y actualizar el mini carrito
                    return fetch("/cart");
                })
                .then((response) => response.text())
                .then((html) => {
                    const parser = new DOMParser();
                    const doc = parser.parseFromString(html, "text/html");

                    const newMiniCart = doc.querySelector("drawer-modal#HeaderMiniCart");
                    const newCartQuantity = doc.querySelector(".head-slot-cart-link-quantity");

                    // Reemplazar el mini carrito en la página actual
                    const currentMiniCart = document.querySelector("drawer-modal#HeaderMiniCart");
                    if (currentMiniCart && newMiniCart) {
                        currentMiniCart.innerHTML = newMiniCart.innerHTML;
                        console.log("Mini carrito actualizado.");
                    }

                    // Actualizar el contador del carrito
                    const cartLinkContainer = document.querySelector(".head-slot-nav-link.head-slot-cart-link");
                    if (cartLinkContainer) {
                        let currentCartQuantity = cartLinkContainer.querySelector(".head-slot-cart-link-quantity");
                        if (currentCartQuantity) {
                            currentCartQuantity.textContent = newCartQuantity?.textContent || "0";
                            console.log("Cantidad en carrito actualizada.");
                        } else {
                            currentCartQuantity = document.createElement("span");
                            currentCartQuantity.classList.add("head-slot-cart-link-quantity");
                            currentCartQuantity.textContent = newCartQuantity?.textContent || "0";
                            cartLinkContainer.appendChild(currentCartQuantity);
                            console.log("Contador del carrito añadido.");
                        }
                    }

                    // Simular un clic en el icono del carrito para abrirlo (si existe)
                    const miniCartToggle = document.querySelector("#mini-cart-toggle");
                    if (miniCartToggle) {
                        document.querySelector(".head-slot-cart-link").click();
                    }
                })
                .catch((error) => {
                    console.error("Error al agregar al carrito:", error);
                })
                .finally(() => {
                    //   Restaurar el texto original y habilitar el botón
                    this.innerHTML = originalText;
                    this.disabled = false;
                });
        });
    });
});
</script>

  




