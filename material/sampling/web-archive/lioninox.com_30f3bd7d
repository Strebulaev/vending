  if (!document.querySelector("#omega-estimated-script")) {
    // Shops that only load the bundle on pages enabled in showOnPages (+ cart).
    // Add a shop domain here to opt it into that gating.
    const ESTIMATED_SHOPS_GATE_SCRIPT_BY_PAGES = ['inny-shop.myshopify.com'];
    const ESTIMATED_ALLOW_SCRIPT_ON_PAGE = true;

    const estimatedShop = window?.Shopify?.shop;
    const estimatedBlocked =
      (estimatedShop === 'mamaandpeachesstore.myshopify.com' &&
        ['home', 'collection'].includes(window?.__st?.p)) ||
      (ESTIMATED_SHOPS_GATE_SCRIPT_BY_PAGES.includes(estimatedShop) && !ESTIMATED_ALLOW_SCRIPT_ON_PAGE);

    if (!estimatedBlocked) {
      const script = document.createElement('script');
      script.id = 'omega-estimated-script';
      script.src = 'https://cdn.shopify.com/extensions/01a12170-7055-75e1-8eee-05e7c90631ce/estimated-shipping-date-905/assets/omega-estimated.min.js';
      script.async = false;
      script.type = 'module';
      document.head.appendChild(script);
    }
  }
</script>
