<!-- 2025-12-18 Knowmad GA4 Ecommerce Event Listener + UTM Persistence -->
<script>
  // --- GA4 Base Setup ---
  window.dataLayer = window.dataLayer || [];

  function gtag(){
    if (typeof window.dataLayer !== "undefined") {
      dataLayer.push(arguments);
    }
  }

  gtag('js', new Date());
  gtag('config', 'G-T58P05LCQK');
  

  (() => {
    /* --------------------------
       Consent
    -------------------------- */
    const hasAnalyticsConsent = () => {
      const match = document.cookie.match(/website_cookies_bar=([^;]+)/);
      if (!match) return true;
      try {
        const value = JSON.parse(decodeURIComponent(match[1]));
        return value.optional === true;
      } catch {
        return false;
      }
    };

    /* --------------------------
       UTM Persistence
    -------------------------- */
    const UTM_KEYS = [
      "utm_source",
      "utm_medium",
      "utm_campaign",
      "utm_term",
      "utm_content"
    ];

    const persistUTMs = () => {
      const params = new URLSearchParams(window.location.search);
      let found = false;

      UTM_KEYS.forEach((key) => {
        if (params.has(key)) {
          sessionStorage.setItem(key, params.get(key));
          found = true;
        }
      });

      return found;
    };

    const getPersistedUTMs = () => {
      const utms = {};
      UTM_KEYS.forEach((key) => {
        const value = sessionStorage.getItem(key);
        if (value) utms[key] = value;
      });
      return utms;
    };

    persistUTMs();

    /* --------------------------
       Helpers
    -------------------------- */
    const numberFromText = (text) => {
      if (!text) return 0;
      const n = parseFloat(String(text).replace(/[^0-9.\-]/g, ""));
      return Number.isFinite(n) ? n : 0;
    };

    const safeTrack = (eventName, params = {}) => {
      const utms = getPersistedUTMs();
      window.dataLayer.push({
        event: eventName,
        ...params,
        ...utms
      });
    };

    const getProductQuantity = () => {
      const qtyEl =
        document.querySelector("input[name='add_qty']") ||
        document.querySelector("input[name='qty']") ||
        document.querySelector("input[name*='quantity']");
      const n = qtyEl ? parseFloat(qtyEl.value) : 1;
      return !Number.isFinite(n) || n <= 0 ? 1 : n;
    };

    const getCartItemsFromDom = () => {
      const items = [];
      const container =
        document.querySelector("#cart_products") ||
        document.querySelector(".js_cart_lines") ||
        document;

      const lines = container.querySelectorAll(
        ".o_cart_product, .o_cart_line, .cart_line, tr[data-product-id]"
      );

      lines.forEach((line) => {
        const nameEl =
          line.querySelector("a h6") ||
          line.querySelector("h6, h5, h4") ||
          line.querySelector("a[href*='/shop/product']");

        const itemName = nameEl?.textContent.trim();
        if (!itemName) return;

        const itemId =
          line.getAttribute("data-product-id") ||
          line.getAttribute("data-product_template_id") ||
          itemName;

        const qtyInput =
          line.querySelector("input.js_quantity") ||
          line.querySelector("input[name*='quantity']");
        const quantity = Math.max(parseFloat(qtyInput?.value) || 1, 1);

        const priceEl = line.querySelector(".oe_currency_value");
        const price = numberFromText(priceEl?.textContent);

        items.push({
          item_id: String(itemId),
          item_name: itemName,
          price,
          quantity
        });
      });

      return items;
    };

    const sumCartValue = (items) =>
      items.reduce((t, i) => t + i.price * i.quantity, 0);

    /* --------------------------
       Main
    -------------------------- */
    const onReady = () => {
      const path = window.location.pathname;
      const isProductPage =
        path.includes("/shop/product") ||
        document.querySelector("h1[itemprop='name']");

      /* View Item */
      if (isProductPage && hasAnalyticsConsent()) {
        const nameEl = document.querySelector("h1[itemprop='name']");
        const idEl = document.querySelector("input[name='product_id']");
        const priceEl = document.querySelector(".oe_currency_value");

        if (nameEl && idEl) {
          const price = numberFromText(priceEl?.textContent);
          safeTrack("view_item", {
            currency: "USD",
            value: price,
            items: [{
              item_id: idEl.value,
              item_name: nameEl.textContent.trim(),
              price,
              quantity: 1
            }]
          });
        }
      }

      /* Add to Cart */
      const addBtn = document.getElementById("add_to_cart");
      if (addBtn) {
        addBtn.addEventListener("click", () => {
          if (!hasAnalyticsConsent()) return;

          const nameEl = document.querySelector("h1[itemprop='name']");
          const idEl = document.querySelector("input[name='product_id']");
          const priceEl = document.querySelector(".oe_currency_value");
          const price = numberFromText(priceEl?.textContent);
          const qty = getProductQuantity();

          safeTrack("add_to_cart", {
            currency: "USD",
            value: price * qty,
            items: [{
              item_id: idEl?.value,
              item_name: nameEl?.textContent.trim(),
              price,
              quantity: qty
            }]
          });
        });
      }

      /* Begin Checkout */
      const checkoutBtn = document.querySelector(
        "a[name='website_sale_main_button']"
      );
      if (checkoutBtn) {
        checkoutBtn.addEventListener("click", () => {
          const items = getCartItemsFromDom();
          safeTrack("begin_checkout", {
            currency: "USD",
            value: sumCartValue(items),
            transport_type: "beacon",
            items
          });
        });
      }

      /* Purchase */
      if (path === "/shop/confirmation") {
        const orderIdEl = document.querySelector(".oe_website_sale_tx_number");
        const totalEl = document.querySelector(".oe_currency_value");

        const items = getCartItemsFromDom();

        safeTrack("purchase", {
          transaction_id: orderIdEl?.textContent.trim(),
          affiliation: "Odoo Webshop",
          currency: "USD",
          value: numberFromText(totalEl?.textContent),
          items
        });
      }
    };

    document.readyState === "loading"
      ? document.addEventListener("DOMContentLoaded", onReady)
      : onReady();
  })();
</script>
    </head>
