require(['Amasty_GdprFrontendUi/js/modal-show'], function (modalConfigInit) {
    modalConfigInit({"isDeclineEnabled":1,"barLocation":0,"policyText":"<style>\r\n.modal-content {\r\n    width: 80% !important;\r\n    max-width: 720px;\r\n    margin: 0 auto;\r\n}\r\n\r\n\/* Logo *\/\r\n.cookie-logo {\r\n    max-width: 220px;\r\n    width: 100%;\r\n    height: auto;\r\n    display: block;\r\n    margin: 0 auto 10px auto;\r\n}\r\n\r\n\/* Texto *\/\r\n.cookie-txt { \r\n    font-size: 12px; \r\n    line-height: 1.45;\r\n    padding-top: 6px;\r\n    margin: 0 0 6px 0;\r\n}\r\n\r\n.action-close::before {\r\n    color: #1c4693 !important;\r\n    font-weight: 900 !important;\r\n}\r\n\r\n.amgdprjs-bar-template {\r\n    border-top: 1px solid #1c4693 !important;\r\n}\r\n\r\n\/* Bot\u00f5es *\/\r\n.amgdprcookie-button {\r\n    flex-basis: unset !important;\r\n    font-size: 11px !important;\r\n    width: auto !important;\r\n    min-width: 150px;\r\n    max-width: 100%;\r\n    padding: 8px 12px !important;\r\n    line-height: 1.2;\r\n    white-space: normal;\r\n    text-align: center;\r\n}\r\n\r\n.amgdprcookie-buttons-block { \r\n    align-items: center !important;\r\n    padding-top: 10px !important;\r\n    flex-direction: column !important;\r\n    gap: 8px;\r\n}\r\n\r\n.amgdprcookie-policy { \r\n    float: left;\r\n    max-width: 70% !important;\r\n}\r\n\r\n.amgdprcookie-bar-container {\r\n    padding: 10px 15px;\r\n}\r\n\r\n\/* Mobile *\/\r\n@media only screen and (max-width: 768px) {\r\n    .modal-content {\r\n        width: 94% !important;\r\n        max-height: 88vh;\r\n        overflow-y: auto;\r\n        border-radius: 10px;\r\n    }\r\n\r\n    .amgdprcookie-bar-container {\r\n        padding: 14px 16px;\r\n        max-height: 88vh;\r\n        overflow-y: auto;\r\n        box-sizing: border-box;\r\n    }\r\n\r\n    .cookie-logo {\r\n        max-width: 150px;\r\n        margin-bottom: 8px;\r\n    }\r\n\r\n    .cookie-txt {\r\n        font-size: 11px;\r\n        line-height: 1.35;\r\n        padding-top: 4px;\r\n        margin-bottom: 5px;\r\n    }\r\n\r\n    .cookie-txt strong {\r\n        font-size: 13px;\r\n        display: block;\r\n        text-align: center;\r\n        margin-bottom: 4px;\r\n    }\r\n\r\n    .amgdprcookie-policy {\r\n        float: unset;\r\n        max-width: 100% !important;\r\n        max-height: unset !important;\r\n    }\r\n\r\n    .amgdprcookie-buttons-block {\r\n        width: 100%;\r\n        padding-top: 8px !important;\r\n        gap: 5px;\r\n    }\r\n\r\n    .amgdprcookie-button {\r\n        width: 100% !important;\r\n        min-width: unset !important;\r\n        max-width: 260px;\r\n        font-size: 11px !important;\r\n        padding: 7px 10px !important;\r\n        line-height: 1.15;\r\n        min-height: unset !important;\r\n        box-sizing: border-box;\r\n    }\r\n}\r\n\r\n\/* Mobile pequeno *\/\r\n@media only screen and (max-width: 480px) {\r\n    .modal-content {\r\n        width: 96% !important;\r\n        max-height: 85vh;\r\n    }\r\n\r\n    .amgdprcookie-bar-container {\r\n        padding: 12px;\r\n        max-height: 85vh;\r\n    }\r\n\r\n    .cookie-logo {\r\n        max-width: 130px;\r\n    }\r\n\r\n    .cookie-txt {\r\n        font-size: 10.5px;\r\n        line-height: 1.3;\r\n    }\r\n\r\n    .cookie-txt:nth-of-type(3) {\r\n        display: none;\r\n    }\r\n\r\n    .amgdprcookie-buttons-block {\r\n        gap: 4px;\r\n    }\r\n\r\n    .amgdprcookie-button {\r\n        max-width: 230px;\r\n        font-size: 10.5px !important;\r\n        padding: 6px 9px !important;\r\n    }\r\n}\r\n<\/style>\r\n\r\n<img \r\n    src=\"\/media\/wysiwyg\/cookiebanner\/logo-cookie.jpg\" \r\n    class=\"cookie-logo\"\r\n    alt=\"Cookie preferences\"\r\n>\r\n\r\n<div>\r\n    <p class=\"cookie-txt\">\r\n        <strong>Manage your cookie preferences your way.<\/strong>\r\n    <\/p>\r\n\r\n    <p class=\"cookie-txt\">\r\n        We use cookies on this site. Some are strictly necessary for the site to function, while others help provide a personalized experience, content, and offers. They also help us understand how the site is used and improve its performance.\r\n    <\/p>\r\n\r\n    <p class=\"cookie-txt\">\r\n        Strictly necessary cookies are always enabled. You can accept or refuse non-strictly necessary cookies by clicking on \u201cAccept All Cookies\u201d or \u201cRefuse All Cookies.\u201d You can also customize your preferences by clicking on \u201cManage Cookie Preferences.\u201d You can change your settings at any time.\r\n    <\/p>\r\n\r\n    <p class=\"cookie-txt\">\r\n        To learn more about cookies and your rights, please consult the privacy policy.\r\n    <\/p>\r\n<\/div>","firstShowProcess":"0","cssConfig":{"backgroundColor":null,"policyTextColor":null,"textColor":null,"titleColor":null,"linksColor":null,"acceptBtnColor":"#1E4693","acceptBtnColorHover":null,"acceptBtnTextColor":null,"acceptBtnTextColorHover":null,"acceptBtnOrder":"1","allowBtnTextColor":"#1E4693","allowBtnTextColorHover":null,"allowBtnColor":null,"allowBtnColorHover":null,"allowBtnOrder":"3","declineBtnTextColorHover":null,"declineBtnColorHover":null,"declineBtnTextColor":"#1E4693","declineBtnColor":null,"declineBtnOrder":"2"},"isAllowCustomersCloseBar":true,"isPopup":false,"isModal":false,"className":"amgdprjs-bar-template","buttons":[{"label":"Accept All Cookies","dataJs":"accept","class":"-allow -save","action":"allowCookies"},{"label":"Manage Cookies Preferences","dataJs":"settings","class":"-settings"},{"label":"Refuse All Cookies","dataJs":"decline","class":"-decline","action":"declineCookie"}],"template":"<div role=\"alertdialog\"\n     class=\"modal-popup _show amgdprcookie-bar-container <% if (data.isPopup) { %>-popup<% } %>\"\n     data-amcookie-js=\"bar\"\n     aria-label=\"<%= phrase.cookieBar %>\"\n>\n    <div data-amgdprcookie-focus-start tabindex=\"0\">\n        <span tabindex=\"0\" class=\"amgdprcookie-focus-guard\" data-focus-to=\"last\"><\/span>\n        <% if (data.isAllowCustomersCloseBar){ %>\n        <button class=\"action-close\" data-amcookie-js=\"close-cookiebar\" type=\"button\">\n            <span data-bind=\"i18n: 'Close Cookie Bar'\"><\/span>\n        <\/button>\n        <% } %>\n        <div class=\"amgdprcookie-bar-block\">\n            <div id=\"amgdprcookie-policy-text\" class=\"amgdprcookie-policy\"><%= data.policyText %><\/div>\n            <div class=\"amgdprcookie-buttons-block\">\n                <% _.each(data.buttons, function(button) { %>\n                <button\n                    class=\"amgdprcookie-button <%= button.class %>\"\n                    disabled\n                    data-amgdprcookie-js=\"<%= button.dataJs %>\"\n                >\n                    <%= button.label %>\n                <\/button>\n                <% }); %>\n            <\/div>\n        <\/div>\n        <span tabindex=\"0\" class=\"amgdprcookie-focus-guard\" data-focus-to=\"first\"><\/span>\n    <\/div>\n<\/div>\n\n<style>\n    <% if(css.backgroundColor){ %>\n    .amgdprcookie-bar-container {\n        background-color: <%= css.backgroundColor %>\n    }\n    <% } %>\n    <% if(css.policyTextColor){ %>\n    .amgdprcookie-bar-container .amgdprcookie-policy {\n        color: <%= css.policyTextColor %>;\n    }\n    <% } %>\n    <% if(css.textColor){ %>\n    .amgdprcookie-bar-container .amgdprcookie-text {\n        color: <%= css.textColor %>;\n    }\n    <% } %>\n    <% if(css.titleColor){ %>\n    .amgdprcookie-bar-container .amgdprcookie-header {\n        color: <%= css.titleColor %>;\n    }\n    <% } %>\n    <% if(css.linksColor){ %>\n    .amgdprcookie-bar-container .amgdprcookie-link,\n    .amgdprcookie-bar-container .amgdprcookie-policy a {\n        color: <%= css.linksColor %>;\n    }\n    <% } %>\n    <% if(css.acceptBtnOrder || css.acceptBtnColor || css.acceptBtnTextColor){ %>\n    .amgdprcookie-bar-container .amgdprcookie-button.-save {\n        <% if(css.acceptBtnOrder) { %>order: <%= css.acceptBtnOrder %>; <% } %>\n        <% if(css.acceptBtnColor) { %>\n            background-color: <%= css.acceptBtnColor %>;\n            border-color: <%= css.acceptBtnColor %>;\n        <% } %>\n        <% if(css.acceptBtnTextColor) { %>color: <%= css.acceptBtnTextColor %>; <% } %>\n    }\n    <% } %>\n    <% if(css.acceptBtnColorHover || css.acceptBtnTextColorHover){ %>\n    .amgdprcookie-bar-container .amgdprcookie-button.-save:hover {\n        <% if(css.acceptBtnColorHover) { %>\n            background-color: <%= css.acceptBtnColorHover %>;\n            border-color: <%= css.acceptBtnColorHover %>;\n        <% } %>\n        <% if(css.acceptBtnTextColorHover) { %> color: <%= css.acceptBtnTextColorHover %>; <% } %>\n    }\n    <% } %>\n    <% if(css.allowBtnOrder || css.allowBtnColor || css.allowBtnTextColor){ %>\n    .amgdprcookie-bar-container .amgdprcookie-button.-settings {\n        <% if(css.allowBtnOrder) { %> order: <%= css.allowBtnOrder %>; <% } %>\n        <% if(css.allowBtnColor) { %>\n            background-color: <%= css.allowBtnColor %>;\n            border-color: <%= css.allowBtnColor %>;\n        <% } %>\n        <% if(css.allowBtnTextColor) { %> color: <%= css.allowBtnTextColor %>; <% } %>\n    }\n    <% } %>\n    <% if(css.allowBtnColorHover || css.allowBtnTextColorHover){ %>\n    .amgdprcookie-bar-container .amgdprcookie-button.-settings:hover {\n        <% if(css.allowBtnColorHover) { %>\n            background-color: <%= css.allowBtnColorHover %>;\n            border-color: <%= css.allowBtnColorHover %>;\n        <% } %>\n        <% if(css.allowBtnTextColorHover) { %> color: <%= css.allowBtnTextColorHover %>; <% } %>\n    }\n    <% } %>\n    <% if(css.declineBtnOrder || css.declineBtnColor || css.declineBtnTextColor){ %>\n    .amgdprcookie-bar-container .amgdprcookie-button.-decline {\n        <% if(css.declineBtnOrder) { %> order: <%= css.declineBtnOrder %>; <% } %>\n        <% if(css.declineBtnColor) { %>\n            background-color: <%= css.declineBtnColor %>;\n            border-color: <%= css.declineBtnColor %>;\n        <% } %>\n        <% if(css.declineBtnTextColor) { %> color: <%= css.declineBtnTextColor %>; <% } %>\n    }\n    <% } %>\n    <% if(css.declineBtnColorHover || css.declineBtnTextColorHover){ %>\n    .amgdprcookie-bar-container .amgdprcookie-button.-decline:hover {\n        <% if(css.declineBtnColorHover) { %>\n            background-color: <%= css.declineBtnColorHover %>;\n            border-color: <%= css.declineBtnColorHover %>;\n        <% } %>\n        <% if(css.declineBtnTextColorHover) { %> color: <%= css.declineBtnTextColorHover %>; <% } %>\n    }\n    <% } %>\n<\/style>\n"});
