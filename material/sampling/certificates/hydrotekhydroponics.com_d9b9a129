</script></div><div data-content-type="html" data-appearance="default" data-element="main" data-decoded="true"><script type="text/javascript">
    require(['jquery'], function($){
        $(document).ready( function() {
            let attempts = 0;
            
            // Loop that checks the DOM every 300ms
            let checkMenu = setInterval(function() {
                attempts++;
                
                // 1. Safe check: Get the authorization link (preventing 'undefined' errors)
                let $authLink = $('.authorization-link > a');
                let href = $authLink.length > 0 ? $authLink.attr('href') : '';
                
                // 2. Check login status: If the link contains '/login', user is logged OUT
                let isNotLoggedIn = href.indexOf('/login') >= 0;

                // 3. If user is NOT logged in, remove the elements
                if (isNotLoggedIn) {
                    
                    // ==========================================
                    // DESKTOP VERSION
                    // ==========================================
                    $(".promotion-main").remove();
                    $(".items-on-sale-main").remove();

                    // ==========================================
                    // MOBILE VERSION
                    // ==========================================
                    let $mobilePromotions = $('a.ammenu-link.-mobile[href*="promotions/id/1533"]').closest('li.ammenu-item');
                    if ($mobilePromotions.length > 0) {
                        $mobilePromotions.remove();
                    }
                }

                // Stop the loop after ~5 seconds (17 attempts x 300ms)
                // This gives Knockout.js plenty of time to fully render both menus
                if (attempts > 17) {
                    clearInterval(checkMenu);
                }
                
            }, 300);
       });
    });
</script></div>                
