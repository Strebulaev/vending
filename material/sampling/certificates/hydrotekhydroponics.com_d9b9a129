<script data-cfasync="false" src="/cdn-cgi/scripts/5c5dd728/cloudflare-static/email-decode.min.js"></script><script>
  // Update copyright year automatically
  document.getElementById('year').textContent = new Date().getFullYear();

  // Mobile accordion behavior for footer link columns
  (function(){
    const mq = window.matchMedia('(max-width: 959px)');
    const sections = Array.from(document.querySelectorAll('.footer-links section'));

    function makeCollapsible(){
      sections.forEach(sec => {
        const header = sec.querySelector('h3');
        if(!header) return;
        // mark initialized
        if(!sec.dataset.init){
          header.setAttribute('tabindex','0');
          header.setAttribute('role','button');
          header.setAttribute('aria-expanded','false');
          header.addEventListener('click', () => toggle(sec, header));
          header.addEventListener('keydown', (e)=>{
            if(e.key === 'Enter' || e.key === ' '){ e.preventDefault(); toggle(sec, header); }
          });
          sec.dataset.init = '1';
        }
        sec.classList.remove('open');
        header.setAttribute('aria-expanded','false');
      });
    }

    function removeCollapsible(){
      sections.forEach(sec => {
        const header = sec.querySelector('h3');
        if(!header) return;
        sec.classList.remove('open');
        header.removeAttribute('tabindex');
        header.removeAttribute('role');
        header.removeAttribute('aria-expanded');
      });
    }

    function toggle(sec, header){
      const isOpen = sec.classList.toggle('open');
      header.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
    }

    function apply(){
      if(mq.matches){ makeCollapsible(); }
      else { removeCollapsible(); }
    }

    mq.addEventListener ? mq.addEventListener('change', apply) : mq.addListener(apply);
    window.addEventListener('load', apply);
    apply();
  })();
</script>

