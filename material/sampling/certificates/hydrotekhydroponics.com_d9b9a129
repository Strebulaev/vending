}

.footer.content .container.id-2 .links a {
	color: initial;
	text-decoration: none;
}

.footer.content .container.id-2 .links a:hover {
	color: #1c4693;
	text-shadow: 0 0 1px #1c4693;
}

.footer.content .container.id-2 .block-wrapper {
