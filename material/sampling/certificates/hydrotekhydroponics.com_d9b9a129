,&quot;is_category&quot;:true,&quot;id&quot;:&quot;category-node-1655&quot;,&quot;status&quot;:1,&quot;sort_order&quot;:&quot;100016&quot;,&quot;content&quot;:&quot;&lt;!-- ko scope: \&quot;index = ammenu_columns_wrapper\&quot; --&gt; &lt;!-- ko template: getTemplate() --&gt;&lt;!-- \/ko --&gt; &lt;!-- \/ko --&gt;&quot;,&quot;url&quot;:&quot;https:\/\/www.hydrotekhydroponics.com\/collections\/garden-tools-accessories-more&quot;,&quot;current&quot;:false,&quot;hide_mobile_content&quot;:false,&quot;submenu_animation&quot;:null},{&quot;type&quot;:{&quot;value&quot;:0,&quot;label&quot;:&quot;do not show&quot;},&quot;submenu_type&quot;:false,&quot;width&quot;:0,&quot;width_value&quot;:0,&quot;column_count&quot;:4,&quot;hide_content&quot;:false,&quot;desktop_font&quot;:700,&quot;mobile_font&quot;:700,&quot;elems&quot;:[],&quot;__disableTmpl&quot;:true,&quot;name&quot;:&quot;New Products&quot;,&quot;is_category&quot;:true,&quot;id&quot;:&quot;category-node-1661&quot;,&quot;status&quot;:1,&quot;sort_order&quot;:&quot;14&quot;,&quot;content&quot;:&quot;&quot;,&quot;url&quot;:&quot;https:\/\/www.hydrotekhydroponics.com\/collections\/new-products&quot;,&quot;current&quot;:false,&quot;hide_mobile_content&quot;:false,&quot;submenu_animation&quot;:null},{&quot;type&quot;:{&quot;value&quot;:0,&quot;label&quot;:&quot;do not show&quot;},&quot;submenu_type&quot;:false,&quot;width&quot;:0,&quot;width_value&quot;:0,&quot;column_count&quot;:4,&quot;hide_content&quot;:false,&quot;desktop_font&quot;:700,&quot;mobile_font&quot;:700,&quot;elems&quot;:[],&quot;__disableTmpl&quot;:true,&quot;name&quot;:&quot;Promotions&quot;,&quot;is_category&quot;:true,&quot;id&quot;:&quot;category-node-1662&quot;,&quot;status&quot;:1,&quot;sort_order&quot;:&quot;15&quot;,&quot;content&quot;:&quot;&quot;,&quot;url&quot;:&quot;https:\/\/www.hydrotekhydroponics.com\/collections\/promotions&quot;,&quot;current&quot;:false,&quot;hide_mobile_content&quot;:false,&quot;submenu_animation&quot;:null}],&quot;__disableTmpl&quot;:true,&quot;name&quot;:&quot;Products&quot;,&quot;is_category&quot;:true,&quot;id&quot;:&quot;category-node-1660&quot;,&quot;status&quot;:1,&quot;sort_order&quot;:&quot;0&quot;,&quot;content&quot;:&quot;&lt;div data-content-type=\&quot;html\&quot; data-appearance=\&quot;default\&quot; data-element=\&quot;main\&quot; data-decoded=\&quot;true\&quot;&gt;&lt;style&gt;\r\n  :root {\r\n    --ht-mega-brand: #1c4693;\r\n    --ht-mega-brand-dark: #1f2740;\r\n    --ht-mega-accent: #57b956;\r\n    --ht-mega-warm: #f2a718;\r\n    --ht-mega-ink: #1f2740;\r\n    --ht-mega-muted: #607087;\r\n    --ht-mega-line: #d9e0eb;\r\n    --ht-mega-soft: #f5f7fb;\r\n    --ht-mega-blue-soft: #e7ecf7;\r\n    --ht-mega-white: #fff;\r\n    --ht-mega-width: 1200px;\r\n    --ht-mega-shadow: 0 14px 36px rgba(31, 39, 64, 0.16);\r\n  }\r\n\r\n  .ht-product-mega,\r\n  .ht-product-mega * {\r\n    box-sizing: border-box;\r\n  }\r\n\r\n  .ht-product-mega {\r\n    color: var(--ht-mega-ink);\r\n    \/* Open Sans matches the Hydrotek theme; fallbacks keep the text readable. *\/\r\n    font-family: \&quot;Open Sans\&quot;, Arial, Helvetica, sans-serif;\r\n    font-size: 14px;\r\n    -webkit-font-smoothing: antialiased;\r\n    -moz-osx-font-smoothing: grayscale;\r\n    text-align: left;\r\n    text-transform: none;\r\n    letter-spacing: normal;\r\n  }\r\n\r\n  .ht-product-mega ul,\r\n  .ht-product-mega li {\r\n    padding: 0;\r\n    margin: 0;\r\n    list-style: none;\r\n  }\r\n\r\n  .ht-product-mega a {\r\n    color: inherit;\r\n    text-decoration: none;\r\n  }\r\n\r\n  @media (min-width: 1025px) {\r\n    .navigation {\r\n      position: relative;\r\n      overflow: visible !important;\r\n    }\r\n\r\n    .navigation .level0.ht-products-item {\r\n      position: static !important;\r\n      overflow: visible !important;\r\n    }\r\n\r\n    .navigation .level0.ht-products-item &gt; .ht-product-mega {\r\n      position: absolute;\r\n      z-index: 1000;\r\n      top: calc(100% + 10px);\r\n      left: 50%;\r\n      width: min(var(--ht-mega-width), calc(100vw - 40px));\r\n      padding: 14px;\r\n      display: block !important;\r\n      visibility: hidden;\r\n      opacity: 0;\r\n      background: var(--ht-mega-white);\r\n      border: 1px solid rgba(28, 70, 147, .48);\r\n      border-radius: 0;\r\n      box-shadow: var(--ht-mega-shadow);\r\n      transform: translate(-50%, -8px);\r\n      pointer-events: none;\r\n      transition: opacity 170ms ease, transform 170ms ease, visibility 170ms;\r\n    }\r\n\r\n    \/* Keeps the hover area active across the small gap above the panel. *\/\r\n    .navigation .level0.ht-products-item &gt; .ht-product-mega::before {\r\n      content: \&quot;\&quot;;\r\n      position: absolute;\r\n      right: 0;\r\n      bottom: 100%;\r\n      left: 0;\r\n      height: 12px;\r\n    }\r\n\r\n    .navigation .level0.ht-products-item:hover &gt; .ht-product-mega,\r\n    .navigation .level0.ht-products-item:focus-within &gt; .ht-product-mega {\r\n      display: block !important;\r\n      visibility: visible !important;\r\n      opacity: 1 !important;\r\n      transform: translate(-50%, 0);\r\n      pointer-events: auto !important;\r\n    }\r\n  }\r\n\r\n  .ht-product-mega__layout {\r\n    position: relative;\r\n    isolation: isolate;\r\n    display: grid;\r\n    grid-template-columns: clamp(260px, 24vw, 300px) clamp(260px, 24vw, 300px) 226px minmax(0, 1fr);\r\n    grid-template-rows: minmax(0, 1fr);\r\n    height: 460px;\r\n    min-height: 460px;\r\n    gap: 10px;\r\n    background-color: #fff !important;\r\n    opacity: 1 !important;\r\n  }\r\n\r\n  .ht-product-mega__layout::before {\r\n    content: \&quot;\&quot;;\r\n    position: absolute;\r\n    z-index: 0;\r\n    grid-column: 3 \/ 5;\r\n    grid-row: 1;\r\n    inset: 0 0 0 -10px;\r\n    background: #e6eaf1;\r\n    pointer-events: none;\r\n  }\r\n\r\n  .ht-product-mega__categories {\r\n    padding: 10px 8px;\r\n    background: var(--ht-mega-soft) !important;\r\n    opacity: 1 !important;\r\n    overflow: visible;\r\n    border-radius: 0;\r\n  }\r\n\r\n  .ht-product-mega__categories &gt; ul {\r\n    display: flex;\r\n    flex-direction: column;\r\n    height: 100%;\r\n  }\r\n\r\n  .ht-product-mega__categories &gt; ul &gt; li {\r\n    display: flex;\r\n    flex: 1 1 0;\r\n    min-height: 0;\r\n  }\r\n\r\n  .ht-product-mega__category-link {\r\n    display: flex !important;\r\n    flex: 1 1 auto;\r\n    align-items: center;\r\n    justify-content: space-between;\r\n    min-height: 0;\r\n    padding: 4px 10px !important;\r\n    margin: 1px 0;\r\n    border-radius: 0;\r\n    color: var(--ht-mega-ink) !important;\r\n    background: transparent !important;\r\n    font-size: 13px !important;\r\n    font-weight: 700 !important;\r\n    line-height: 1.25 !important;\r\n    letter-spacing: -0.01em;\r\n    white-space: nowrap;\r\n    transition: color 150ms ease, background-color 150ms ease, transform 150ms ease;\r\n  }\r\n\r\n  .ht-product-mega__category-link::after {\r\n    content: \&quot;\&quot;;\r\n    width: 7px;\r\n    height: 7px;\r\n    border-top: 1.5px solid currentColor;\r\n    border-right: 1.5px solid currentColor;\r\n    transform: rotate(45deg);\r\n  }\r\n\r\n  .ht-product-mega__category-link:hover,\r\n  .ht-product-mega__category-link:focus-visible,\r\n  .ht-product-mega__category-link.is-active {\r\n    color: var(--ht-mega-white) !important;\r\n    background: var(--ht-mega-brand) !important;\r\n    box-shadow: none;\r\n    transform: translateX(2px);\r\n  }\r\n\r\n  .ht-product-mega__levels {\r\n    min-width: 0;\r\n    height: 460px;\r\n    min-height: 0;\r\n    padding: 15px 20px;\r\n    background: #fff !important;\r\n    opacity: 1 !important;\r\n    overflow: hidden;\r\n    isolation: isolate;\r\n  }\r\n\r\n  .ht-product-mega__category-panel[hidden] {\r\n    display: none;\r\n  }\r\n\r\n  .ht-product-mega__category-panel {\r\n    display: grid;\r\n    grid-template-columns: minmax(0, 1fr);\r\n    height: 430px;\r\n    min-height: 0;\r\n    overflow: hidden;\r\n    background: #fff !important;\r\n    opacity: 1 !important;\r\n  }\r\n\r\n  .ht-product-mega__category-panel &gt; div {\r\n    display: flex;\r\n    flex-direction: column;\r\n    height: 100%;\r\n    min-height: 0;\r\n    background: #fff !important;\r\n    opacity: 1 !important;\r\n  }\r\n\r\n  .ht-product-mega__category-title {\r\n    padding: 0 0 15px;\r\n    margin: 0 0 9px;\r\n    border-bottom: 1px solid var(--ht-mega-line);\r\n    color: #1E4693;\r\n    font-size: 20px;\r\n    font-weight: 700;\r\n    line-height: 1.2;\r\n    letter-spacing: -.03em;\r\n  }\r\n\r\n  .ht-product-mega__levels .ht-product-mega__category-title {\r\n    border-bottom: 2px solid #1E4693;\r\n  }\r\n\r\n  .ht-product-mega__sub-list {\r\n    display: grid;\r\n    grid-template-columns: minmax(0, 1fr);\r\n    flex: 1 1 auto;\r\n    align-content: start;\r\n    min-height: 0;\r\n    overflow-y: auto;\r\n    scrollbar-width: thin;\r\n    row-gap: 0;\r\n  }\r\n\r\n  .ht-product-mega__sub-link {\r\n    display: flex !important;\r\n    align-items: center;\r\n    justify-content: space-between;\r\n    min-height: 31px;\r\n    padding: 4px 0 !important;\r\n    margin-left: -5px;\r\n    padding-left: 2px !important;\r\n    border-left: 3px solid transparent;\r\n    border-radius: 0;\r\n    color: var(--ht-mega-ink) !important;\r\n    background: transparent !important;\r\n    font-size: 12px !important;\r\n    font-weight: 600 !important;\r\n    line-height: 1.2 !important;\r\n    transition: color 150ms ease, background-color 150ms ease, transform 150ms ease;\r\n  }\r\n\r\n  .ht-product-mega__sub-link:hover,\r\n  .ht-product-mega__sub-link:focus-visible {\r\n    color: var(--ht-mega-brand-dark) !important;\r\n    background: var(--ht-mega-blue-soft) !important;\r\n    border-left-color: var(--ht-mega-brand);\r\n    transform: none;\r\n  }\r\n\r\n  .ht-product-mega__all {\r\n    display: inline-flex !important;\r\n    flex: 0 0 auto;\r\n    align-items: center;\r\n    gap: 7px;\r\n    margin: 13px 0 0;\r\n    color: var(--ht-mega-brand) !important;\r\n    background: transparent !important;\r\n    font-size: 11px !important;\r\n    font-weight: 700 !important;\r\n  }\r\n\r\n  .ht-product-mega__all:hover,\r\n  .ht-product-mega__all:focus-visible {\r\n    color: var(--ht-mega-brand-dark) !important;\r\n    text-decoration: underline;\r\n    text-underline-offset: 4px;\r\n  }\r\n\r\n  .ht-product-mega__deals,\r\n  .ht-product-mega__feature-stack {\r\n    position: relative;\r\n    z-index: 1;\r\n    min-width: 0;\r\n    background: transparent !important;\r\n    opacity: 1 !important;\r\n  }\r\n\r\n  .ht-product-mega__deals {\r\n    display: flex;\r\n    flex-direction: column;\r\n    gap: 8px;\r\n    padding: 15px 6px 6px 0 !important;\r\n    grid-column: 4;\r\n    grid-row: 1;\r\n  }\r\n\r\n  .ht-product-mega__deals &gt; .ht-product-mega__category-title {\r\n    margin-left: 0 !important;\r\n    border-bottom: 2px solid #1E4693;\r\n  }\r\n\r\n  .ht-product-mega__deal-banner {\r\n    position: relative;\r\n    display: block !important;\r\n    flex: 1 1 0;\r\n    min-height: 0;\r\n    overflow: hidden;\r\n    background: var(--ht-mega-brand-dark) !important;\r\n    border: 1px solid rgba(28, 70, 147, .22);\r\n    border-radius: 0;\r\n    transition: transform 150ms ease, box-shadow 150ms ease;\r\n  }\r\n\r\n  .ht-product-mega__deal-banner img {\r\n    display: block !important;\r\n    width: 100% !important;\r\n    height: 100% !important;\r\n    min-height: 0;\r\n    object-fit: cover;\r\n    opacity: 1 !important;\r\n  }\r\n\r\n  .ht-product-mega__deal-banner span {\r\n    position: absolute;\r\n    right: 9px;\r\n    bottom: 7px;\r\n    left: 9px;\r\n    color: var(--ht-mega-white);\r\n    font-size: 11px;\r\n    font-weight: 700;\r\n    line-height: 1.2;\r\n    text-shadow: 0 1px 3px rgba(0, 0, 0, .4);\r\n  }\r\n\r\n  .ht-product-mega__deal-banner:hover,\r\n  .ht-product-mega__deal-banner:focus-visible {\r\n    box-shadow: 0 5px 12px rgba(31, 39, 64, .16);\r\n    transform: translateY(-2px);\r\n  }\r\n\r\n  .ht-product-mega__feature-stack {\r\n    display: flex;\r\n    flex-direction: column;\r\n    gap: 8px;\r\n    padding: 6px 6px 6px 0 !important;\r\n    grid-column: 3;\r\n    grid-row: 1;\r\n  }\r\n\r\n  .ht-product-mega__square-feature {\r\n    position: relative;\r\n    display: block !important;\r\n    width: 100%;\r\n    min-height: 0;\r\n    flex: 0 0 auto;\r\n    aspect-ratio: 1 \/ 1;\r\n    overflow: hidden;\r\n    background: var(--ht-mega-blue-soft) !important;\r\n    border: 1px solid rgba(28, 70, 147, .22);\r\n    border-radius: 0;\r\n    transition: transform 150ms ease, box-shadow 150ms ease;\r\n  }\r\n\r\n  .ht-product-mega__square-feature img {\r\n    display: block !important;\r\n    width: 100% !important;\r\n    height: 100% !important;\r\n    object-fit: cover;\r\n    opacity: 1 !important;\r\n  }\r\n\r\n  .ht-product-mega__square-feature span {\r\n    position: absolute;\r\n    right: 9px;\r\n    bottom: 8px;\r\n    left: 9px;\r\n    color: var(--ht-mega-white);\r\n    font-size: 11px;\r\n    font-weight: 700;\r\n    line-height: 1.2;\r\n    text-shadow: 0 1px 3px rgba(0, 0, 0, .45);\r\n  }\r\n\r\n  .ht-product-mega__square-feature:hover,\r\n  .ht-product-mega__square-feature:focus-visible {\r\n    box-shadow: 0 5px 12px rgba(31, 39, 64, .16);\r\n    transform: translateY(-2px);\r\n  }\r\n\r\n  .ht-product-mega :focus-visible {\r\n    outline: 3px solid rgba(28, 70, 147, .3);\r\n    outline-offset: 2px;\r\n  }\r\n\r\n  @media (max-width: 1024px) {\r\n    .ht-product-mega {\r\n      display: none !important;\r\n    }\r\n  }\r\n\r\n  \/* Magento navigation overrides for the embedded desktop menu. *\/\r\n  @media (min-width: 1025px) {\r\n    .navigation .level0.ht-products-item &gt; .ht-product-mega .ht-product-mega__layout {\r\n      display: grid !important;\r\n      grid-template-columns: clamp(260px, 24vw, 300px) clamp(260px, 24vw, 300px) 226px minmax(0, 1fr) !important;\r\n      gap: 10px !important;\r\n    }\r\n\r\n    .navigation .level0.ht-products-item &gt; .ht-product-mega .ht-product-mega__feature-stack {\r\n      position: relative !important;\r\n      z-index: 1 !important;\r\n      display: flex !important;\r\n      flex-direction: column !important;\r\n      gap: 8px !important;\r\n      width: auto !important;\r\n      min-width: 0 !important;\r\n      background: transparent !important;\r\n      padding: 6px 6px 6px 0 !important;\r\n      margin: 0 !important;\r\n      grid-column: 3 !important;\r\n      grid-row: 1 !important;\r\n      box-sizing: border-box !important;\r\n    }\r\n\r\n    .navigation .level0.ht-products-item &gt; .ht-product-mega .ht-product-mega__levels {\r\n      padding-left: 20px !important;\r\n    }\r\n\r\n    .navigation .level0.ht-products-item &gt; .ht-product-mega .ht-product-mega__levels .ht-product-mega__category-title {\r\n      border-bottom: 2px solid #1E4693 !important;\r\n    }\r\n\r\n    .navigation .level0.ht-products-item &gt; .ht-product-mega .ht-product-mega__sub-list {\r\n      grid-template-columns: minmax(0, 1fr) !important;\r\n      column-gap: 0 !important;\r\n      row-gap: 0 !important;\r\n    }\r\n\r\n    .navigation .level0.ht-products-item &gt; .ht-product-mega .ht-product-mega__sub-link {\r\n      margin-left: -5px !important;\r\n      padding-left: 2px !important;\r\n      border-left: 3px solid transparent !important;\r\n    }\r\n\r\n    .navigation .level0.ht-products-item &gt; .ht-product-mega .ht-product-mega__sub-link:hover,\r\n    .navigation .level0.ht-products-item &gt; .ht-product-mega .ht-product-mega__sub-link:focus-visible {\r\n      border-left-color: var(--ht-mega-brand) !important;\r\n      transform: none !important;\r\n    }\r\n\r\n    .navigation .level0.ht-products-item &gt; .ht-product-mega .ht-product-mega__all {\r\n      margin-left: 0 !important;\r\n    }\r\n\r\n    .navigation .level0.ht-products-item &gt; .ht-product-mega .ht-product-mega__square-feature {\r\n      display: block !important;\r\n      width: 100% !important;\r\n      min-width: 0 !important;\r\n      margin: 0 !important;\r\n      flex: 0 0 auto !important;\r\n      aspect-ratio: 1 \/ 1 !important;\r\n      border: 1px solid rgba(28, 70, 147, .22) !important;\r\n      box-sizing: border-box !important;\r\n    }\r\n\r\n    .navigation .level0.ht-products-item &gt; .ht-product-mega .ht-product-mega__deals {\r\n      position: relative !important;\r\n      z-index: 1 !important;\r\n      display: flex !important;\r\n      flex-direction: column !important;\r\n      gap: 8px !important;\r\n      min-width: 0 !important;\r\n      background: transparent !important;\r\n      padding: 15px 6px 6px 0 !important;\r\n      margin: 0 !important;\r\n      grid-column: 4 !important;\r\n      grid-row: 1 !important;\r\n      box-sizing: border-box !important;\r\n    }\r\n\r\n    .navigation .level0.ht-products-item &gt; .ht-product-mega .ht-product-mega__deal-banner {\r\n      border: 1px solid rgba(28, 70, 147, .22) !important;\r\n      box-sizing: border-box !important;\r\n    }\r\n\r\n    .navigation .level0.ht-products-item &gt; .ht-product-mega .ht-product-mega__deals &gt; .ht-product-mega__category-title {\r\n      margin-left: 0 !important;\r\n      border-bottom: 2px solid #1E4693 !important;\r\n    }\r\n  }\r\n\r\n  @media (prefers-reduced-motion: reduce) {\r\n    .ht-product-mega,\r\n    .ht-product-mega * {\r\n      transition-duration: .01ms !important;\r\n    }\r\n  }\r\n\r\n  \/* Shows the panel by itself when this file is opened directly. *\/\r\n  body &gt; .ht-product-mega {\r\n    position: relative;\r\n    width: min(var(--ht-mega-width), calc(100vw - 40px));\r\n    padding: 14px;\r\n    margin: 30px auto;\r\n    background: var(--ht-mega-white);\r\n    border: 1px solid rgba(28, 70, 147, .48);\r\n    border-radius: 0;\r\n    box-shadow: var(--ht-mega-shadow);\r\n  }\r\n&lt;\/style&gt;\r\n\r\n&lt;div class=\&quot;ht-product-mega\&quot; aria-label=\&quot;Product categories\&quot;&gt;\r\n  &lt;div class=\&quot;ht-product-mega__layout\&quot;&gt;\r\n    &lt;aside class=\&quot;ht-product-mega__categories\&quot; aria-label=\&quot;Categories\&quot;&gt;\r\n      &lt;ul&gt;\r\n        &lt;li&gt;&lt;a class=\&quot;ht-product-mega__category-link\&quot; href=\&quot;\/collections\/plant-propagation\&quot; data-category=\&quot;plant-propagation\&quot;&gt;Plant Propagation&lt;\/a&gt;&lt;\/li&gt;\r\n        &lt;li&gt;&lt;a class=\&quot;ht-product-mega__category-link\&quot; href=\&quot;\/collections\/growing-medium\&quot; data-category=\&quot;growing-medium\&quot;&gt;Growing Medium&lt;\/a&gt;&lt;\/li&gt;\r\n        &lt;li&gt;&lt;a class=\&quot;ht-product-mega__category-link\&quot; href=\&quot;\/collections\/plant-pots-containers\&quot; data-category=\&quot;plant-pots-containers\&quot;&gt;Plant Pots &amp; Containers&lt;\/a&gt;&lt;\/li&gt;\r\n        &lt;li&gt;&lt;a class=\&quot;ht-product-mega__category-link\&quot; href=\&quot;\/collections\/plant-nutrients\&quot; data-category=\&quot;plant-nutrients\&quot;&gt;Plant Nutrients &amp; Additives&lt;\/a&gt;&lt;\/li&gt;\r\n        &lt;li&gt;&lt;a class=\&quot;ht-product-mega__category-link\&quot; href=\&quot;\/collections\/grow-lights\&quot; data-category=\&quot;grow-lights\&quot;&gt;Grow Lights&lt;\/a&gt;&lt;\/li&gt;\r\n        &lt;li&gt;&lt;a class=\&quot;ht-product-mega__category-link\&quot; href=\&quot;\/collections\/climate-control\&quot; data-category=\&quot;climate-control\&quot;&gt;Climate Control&lt;\/a&gt;&lt;\/li&gt;\r\n        &lt;li&gt;&lt;a class=\&quot;ht-product-mega__category-link\&quot; href=\&quot;\/collections\/grow-carts\&quot; data-category=\&quot;grow-carts\&quot;&gt;Grow Carts&lt;\/a&gt;&lt;\/li&gt;\r\n        &lt;li&gt;&lt;a class=\&quot;ht-product-mega__category-link\&quot; href=\&quot;\/collections\/bench-tray-systems\&quot; data-category=\&quot;bench-tray-systems\&quot;&gt;Bench &amp; Tray Systems&lt;\/a&gt;&lt;\/li&gt;\r\n        