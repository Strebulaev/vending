es &amp; Scales&lt;\/a&gt;&lt;\/li&gt;\r\n            &lt;li&gt;&lt;a class=\&quot;ht-product-mega__sub-link\&quot; href=\&quot;\/collections\/garden-tools-accessories-more\/plant-support\&quot; data-subcategory=\&quot;plant-support\&quot;&gt;Plant Support&lt;\/a&gt;&lt;\/li&gt;\r\n          &lt;\/ul&gt;\r\n          &lt;a class=\&quot;ht-product-mega__all\&quot; href=\&quot;\/collections\/garden-tools-accessories-more\&quot;&gt;View all products \u2192&lt;\/a&gt;\r\n        &lt;\/div&gt;\r\n      &lt;\/section&gt;\r\n    &lt;\/div&gt;\r\n\r\n    &lt;aside class=\&quot;ht-product-mega__deals\&quot; aria-label=\&quot;Featured products\&quot;&gt;\r\n      &lt;h2 class=\&quot;ht-product-mega__category-title\&quot;&gt;Featured Products&lt;\/h2&gt;\r\n      &lt;a class=\&quot;ht-product-mega__deal-banner\&quot; href=\&quot;\/brands\/fibrgro\&quot;&gt;\r\n        &lt;img src=\&quot;\/media\/wysiwyg\/megamenu\/hydrotek-mm_featured_01_fibrgro_01-en.jpg\&quot; alt=\&quot;Fibrgro\&quot;&gt;\r\n      &lt;\/a&gt;\r\n      &lt;a class=\&quot;ht-product-mega__deal-banner\&quot; href=\&quot;\/brands\/wachsen\&quot;&gt;\r\n        &lt;img src=\&quot;\/media\/wysiwyg\/megamenu\/hydrotek-mm_featured_03_wachsen-benches_en.jpg\&quot; alt=\&quot;Wachsen Pro\&quot;&gt;\r\n      &lt;\/a&gt;\r\n      &lt;a class=\&quot;ht-product-mega__deal-banner\&quot; href=\&quot;\/brands\/cultiwool\&quot;&gt;\r\n        &lt;img src=\&quot;\/media\/wysiwyg\/megamenu\/hydrotek-mm_featured_02_cultiwool_en.jpg\&quot; alt=\&quot;Cultiwool\&quot;&gt;\r\n      &lt;\/a&gt;\r\n    &lt;\/aside&gt;\r\n\r\n    &lt;aside class=\&quot;ht-product-mega__feature-stack\&quot; aria-label=\&quot;New Products\&quot;&gt;\r\n      &lt;a class=\&quot;ht-product-mega__square-feature\&quot; href=\&quot;\/collections\/new-products\&quot;&gt;\r\n        &lt;img src=\&quot;\/media\/wysiwyg\/megamenu\/hydrotek-mm_01_new-products_v3b.jpg\&quot; alt=\&quot;New Products Button\&quot; title=\&quot;New Products\&quot;&gt;\r\n      &lt;\/a&gt;\r\n      &lt;a class=\&quot;ht-product-mega__square-feature\&quot; href=\&quot;\/collections\/promotions\&quot;&gt;\r\n        &lt;img src=\&quot;\/media\/wysiwyg\/megamenu\/hydrotek-mm_02_promotions_v3.jpg\&quot; alt=\&quot;Promotions Button\&quot; title=\&quot;Promotions\&quot;&gt;\r\n      &lt;\/a&gt;\r\n    &lt;\/aside&gt;\r\n  &lt;\/div&gt;\r\n&lt;\/div&gt;\r\n\r\n&lt;script&gt;\r\n  (() =&gt; {\r\n    \&quot;use strict\&quot;;\r\n    document.querySelectorAll(\&quot;.ht-product-mega\&quot;).forEach((menu) =&gt; {\r\n      const categoryLinks = [...menu.querySelectorAll(\&quot;[data-category]\&quot;)];\r\n      const categoryPanels = [...menu.querySelectorAll(\&quot;[data-category-panel]\&quot;)];\r\n      let pendingCategoryTimer = 0;\r\n\r\n      const activateCategory = (category) =&gt; {\r\n        categoryPanels.forEach((panel) =&gt; {\r\n          const active = panel.dataset.categoryPanel === category;\r\n          panel.hidden = !active;\r\n        });\r\n      };\r\n\r\n      const cancelPendingCategory = () =&gt; {\r\n        window.clearTimeout(pendingCategoryTimer);\r\n        pendingCategoryTimer = 0;\r\n      };\r\n\r\n      const scheduleCategory = (category) =&gt; {\r\n        cancelPendingCategory();\r\n        pendingCategoryTimer = window.setTimeout(() =&gt; {\r\n          activateCategory(category);\r\n          pendingCategoryTimer = 0;\r\n        }, 180);\r\n      };\r\n\r\n      categoryLinks.forEach((link) =&gt; {\r\n        link.addEventListener(\&quot;pointerenter\&quot;, () =&gt; scheduleCategory(link.dataset.category));\r\n        link.addEventListener(\&quot;pointerleave\&quot;, cancelPendingCategory);\r\n        link.addEventListener(\&quot;focus\&quot;, () =&gt; {\r\n          cancelPendingCategory();\r\n          activateCategory(link.dataset.category);\r\n        });\r\n      });\r\n\r\n      menu.addEventListener(\&quot;pointerleave\&quot;, cancelPendingCategory);\r\n    });\r\n  })();\r\n&lt;\/script&gt;\r\n&lt;\/div&gt