                    <style>#html-body [data-pb-style=EKVA8CG]{margin-bottom:25px}</style><div data-content-type="html" data-appearance="default" data-element="main" data-pb-style="EKVA8CG" data-decoded="true"><style>
.footer.content .container.id-1 {
	text-align: left !important;
}

.social-icon-footer {
	fill: #fff;
}

.footer.content .block-wrapper.alias-cms-footer-top>div[data-content-type="html"][data-element="main"] {
	/* your rules here */
	margin-bottom: 0px !important;
}

footer>div>div.container.id-3.__base--grid._op-cols-12._op-md-cols-12._op-lg-cols-12,
.footer.content .subcontainer.id-2-2,
.footer.content .subcontainer.id-2-3,
.footer.content .subcontainer.id-2-4,
.footer.content .subcontainer.id-2-5 {
	display: none !important;
}

/* (Opcional) se quiser remover o espaço/borda da linha inteira */
.footer.content .container.id-2 {
	border: 0 !important;
	padding: 0 !important;
}

/* --- Simple, variable-free CSS for Magento --- */
.footer {
	font-family: Inter, system-ui, Segoe UI, Roboto, Helvetica, Arial, sans-serif;
	color: #e7ecf7;
	background: #1b4594;
}

.footer a {
	color: #fff;
	text-decoration: none;
}

.footer span {
	color: #a9b3c9;
	text-decoration: none;
}

.footer p {
	color: #fff;
	text-decoration: none;
}

.footer a:hover,
.footer a:focus {
	color: #e7ecf7;
}

.footer .wrap {
	max-width: 1500px;
	margin: 0 auto;
	padding: 24px 20px;
}

.footer h3 {
	font-size: 0.95rem;
	letter-spacing: .02em;
	color: #fff;
	margin: 0 0 10px 0;
}

.footer ul {
	list-style: none;
	padding: 0;
	margin: 0;
}

.footer li {
	margin: .45rem 0;
}

.footer .muted {
	color: #fff;
}

.footer .pill {
	display: inline-flex;
	align-items: center;
	gap: .5rem;
	border: 1px solid #1f2740;
	border-radius: 999px;
	padding: .5rem .75rem;
}

.footer .sr-only {
	position: absolute !important;
	height: 1px;
	width: 1px;
	overflow: hidden;
	clip: rect(1px, 1px, 1px, 1px);
}

/* Newsletter strip */
.footer-news {
	background: #333333;
	border-bottom: 1px solid #1f2740;
}

.footer-news .grid {
	display: grid;
	gap: 16px;
	align-items: center;
	grid-template-columns: 1fr;
}

.footer-news h2 {
	font-size: 1.05rem;
	margin: 0;
}

.footer-news form {
	display: flex;
	gap: 10px;
}

.footer-news input {
	flex: 1;
	min-width: 0;
	background: #0b0f1c;
	color: #e7ecf7;
	border: 1px solid #1f2740;
	border-radius: 3px;
	padding: .75rem .9rem;
}

.footer-news button {
	background: linear-gradient(135deg, #6633ee, #19c37d);
	color: #fff;
	border: 0;
	border-radius: 3px;
	padding: .75rem 1rem;
	font-weight: 600;
	cursor: pointer;
}

.footer-news button:hover {
	filter: brightness(1.05);
}

/* Link columns */
.footer-links {
	display: grid;
	gap: 28px;
	padding-top: 18px;
	padding-bottom: 6px;
	line-height: 1.8;
}

@media(min-width:640px) {
	.footer-news .grid {
		grid-template-columns: 1.1fr .9fr;
	}

	.footer-links {
		grid-template-columns: repeat(2, minmax(0, 1fr));
	}
}

@media(min-width:960px) {
	.footer-links {
		grid-template-columns: repeat(4, minmax(0, 1fr));
	}
}

/* Brand pills row */
.brand-row {
	display: flex;
	flex-wrap: wrap;
	gap: 10px;
	margin-top: 12px;
}

/* Bottom bar */
.footer-bottom {
	border-top: 1px solid #1f2740;
	margin-top: 16px;
	padding-top: 16px;
	display: grid;
	gap: 16px;
	align-items: center;
}

@media(min-width:720px) {
	.footer-bottom {
		grid-template-columns: 1fr auto auto;
		gap: 24px;
	}
}

.socials {
	display: flex;
	gap: 12px;
}

#year {
	color: #fff !important;
}

/* Small helper badges */
.badge {
	display: inline-flex;
	align-items: center;
	gap: .5rem;
	padding: .35rem .6rem;
	border: 1px solid #fff;
	border-radius: 3px;
	font-size: 1rem;
	color: #fff !important;
}

/* Mobile accordion for link columns */
@media(max-width:959px) {
	.footer-links {
		grid-template-columns: 1fr !important;
	}

	.footer-links section {
		border-top: 1px solid #1f2740;
		padding-top: 10px;
	}

	.footer-links section h3 {
		display: flex;
		align-items: center;
		justify-content: space-between;
		cursor: pointer;
	}

	.footer-links section h3::after {
		content: "+";
		font-weight: 600;
		line-height: 1;
	}

	.footer-links section.open h3::after {
		content: "-";
	}

	.footer-links section ul {
		max-height: 0;
		overflow: hidden;
		transition: max-height .3s ease;
	}

	.footer-links section.open ul {
		max-height: 420px;
	}
}

@media(min-width:960px) {
	.footer-links section ul {
		max-height: none !important;
		overflow: visible;
	}

	.footer-links section h3 {
		cursor: default;
	}

	.footer-links section h3::after {
		content: "";
	}
}

.footer-links {
	text-align: left !important;
        
}

.page-footer .footer.content {
	margin: 0;
	padding: 0;
	background: #1C1C1C;
}


