    <script>
        window.addEventListener('load', function () {
            require([
                'jquery',
                'Magento_Customer/js/customer-data',
                'matchMedia',
                'domReady!'
            ], function ($, customerData, mediaCheck) {
                var sections = ['cart'];
                customerData.initStorage();
                customerData.invalidate(sections);
                customerData.reload(sections, true);

                var customer = customerData.get('customer');
                customer.subscribe(function (data) {
                    if (data.isLoggedIn) {
                        $(".minicart-wrapper").removeClass("no-display");

                        mediaCheck({
                            media: '(max-width: 768px)',
                            entry: function () {
                                $(".header.links").hide();
                            },

                            exit: function () {
                                $(".header.links").show();
                            },
                        });
                    }
                });

                if (customer().isLoggedIn) {
                    $(".minicart-wrapper").removeClass("no-display");

                    mediaCheck({
                        media: '(max-width: 768px)',
                        entry: function () {
                            $(".header.links").hide();
                        },

                        exit: function () {
                            $(".header.links").show();
                        },
                    });
                }

                mediaCheck({
                    media: '(max-width: 1024px)',
                    entry: function () {
                        setTimeout(function() {
                            $('#switcher-language').clone().appendTo('.ammenu-items');
                        }, 3000);
                    },
                });
            });
        });
    </script>
</div>
                
